# Item de una invitación pendiente: correo, vencimiento y revocar. Nunca muestra el código
# (el servidor solo guarda su hash). Reutilizado en el portal empresa y en el del paseador independiente.
part InviteItem(iv: Invitacion, onDelete: action) {
  Stack class("dd-inv-item") {
    Icon "lucide:mail" class("ic")
    Stack class("dd-inv-info") {
      Span "{$iv.email}" class("em")
      Span "Vence {$iv.vence}" class("code")
    }
    Stack class("dd-inv-acts") {
      Button -> $onDelete($iv.id) class("dd-cat-icon dd-danger") aria(label: "Revocar invitación") { Icon "lucide:x" }
    }
  }
}
