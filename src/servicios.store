# Service catalogue offered by the company (based on the evDogs flyer).
entity Servicio {
  nombre   text required
  desc     text
  emoji    text
  precio   number
  duracion number
  activo   bool
}

state {
  items = [
    { nombre: "Paseo Recreativo",       desc: "Diversión, ejercicio y socialización al aire libre", emoji: "🐾", precio: 15000, duracion: 60,  activo: true  },
    { nombre: "Ejercicio Dirigido",     desc: "Rutina física guiada según la energía del perro",    emoji: "🎾", precio: 18000, duracion: 45,  activo: true  },
    { nombre: "Acompañamiento",         desc: "Visita y compañía en casa mientras no estás",         emoji: "🏠", precio: 20000, duracion: 60,  activo: true  },
    { nombre: "Salida a Recreación",    desc: "Jornada extendida en zona verde y parque canino",     emoji: "🌳", precio: 28000, duracion: 120, activo: true  },
    { nombre: "Actividades Cognitivas", desc: "Juegos de olfato y estimulación mental",              emoji: "🧠", precio: 22000, duracion: 45,  activo: true  },
    { nombre: "Amor y Mimos",           desc: "Sesión de cariño, cepillado y bienestar",             emoji: "💛", precio: 12000, duracion: 30,  activo: false }
  ] : list<Servicio>
}

get count     = items.length
get activos   = items.count where activo
get precioMin = items.min by precio

action toggle(sid: text) mutates items { items.patch where id == sid with { activo: not activo } }
