# DevDogs — app root. Acceso CENTRALIZADO por login (sin slug en la URL).
# El tenant se resuelve del perfil (auth.negocioId), no de la URL. La seguridad
# real de datos la da el RLS de Supabase; los guards de rol son UX.
routes {
  "/"        -> landing                                       # landing pública de la plataforma
  "/login"   -> login   guard not auth.loggedIn else "/app"
  "/signup"  -> signup  guard not auth.loggedIn else "/app"
  "/unirse"  -> unirse  guard not auth.loggedIn else "/app"   # canje de invitación (código)
  "/privacidad" -> privacidad                                  # política de datos (pública, borrador)
  "/politicas" -> politicas                                    # términos y políticas completas (pública, borrador)
  # Derechos del titular (Ley 1581), todos los roles. Si no pasa, la cadena de /app decide (portal, registro, política o /login).
  "/mis-datos" -> misdatos guard auth.canMisDatos else "/app"
  # Ruteo por ROL via cadena de guards: /app dispara al portal correcto.
  #  paseador → /app (dashboard) · empresa → /empresa · cliente → /cliente
  #  Sin perfil (p. ej. primer ingreso con Google), ningún canX pasa y la cadena termina en /completar-registro.
  #  Con una política nueva sin aceptar, ningún canX pasa y la cadena termina en /aceptar-politica.
  #  Sin sesión, la cadena termina en /login (los guards canX, debeCompletar y debeAceptar incluyen loggedIn).
  "/app"     -> dashboard  guard auth.canWalker   else "/empresa"
  "/empresa" -> empresa    guard auth.canBusiness else "/cliente"
  "/cliente" -> cliente    guard auth.canClient   else "/completar-registro"
  "/completar-registro" -> completar guard auth.debeCompletar else "/aceptar-politica"
  "/aceptar-politica" -> aceptar guard auth.debeAceptar else "/login"
}

shell {
  Stack class("frame") {
    # Aviso de red (O4). Lo alimenta el Custom NetWatch montado en cada portal;
    # acá el shell solo lo pinta desde net.store (los Custom del shell no montan).
    when not net.online {
      Stack class("dd-netbar dd-netbar-off") {
        Icon "lucide:wifi-off"
        when auth.isPaseador { Span "Sin conexión — los cambios se guardan y se sincronizan al volver" }
        when not auth.isPaseador { Span "Se necesita conexión para ver tus datos" }
        when net.pending > 0 { Span "· {net.pending} sin enviar" class("dd-netbar-n") }
      }
    }
    when net.online and net.pending > 0 {
      Stack class("dd-netbar dd-netbar-sync") {
        Icon "lucide:refresh-cw"
        Span "Sincronizando {net.pending} cambio(s)…"
      }
    }
    slot
  }
}
