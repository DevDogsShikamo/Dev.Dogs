# Global auth state, backed by Supabase Auth via the SupaSession/SupaAuthForm bridges.
# Now role-aware: after login the profile (rol + negocio) is mirrored here, and
# app.muten routes each rol to its portal.
use signOut from "~/lib/authActions.ts"

entity Session { loggedIn bool  userId text  userName text  rol text  negocioId text  isOwner bool }

state {
  loggedIn  = false : bool persist
  userId    = ""    : text persist
  userName  = ""    : text persist
  rol       = ""    : text persist
  negocioId = ""    : text persist
  isOwner   = false : bool persist   # dueño del negocio (jefe) vs empleado de gestión
  authError = ""    : text
  # Permiso de finanzas (lo informa ReportesBridge desde has_finanzas()). Solo gobierna la UI; el servidor decide.
  finanzas  = false : bool
}

get isPaseador = rol == "paseador"
get isEmpresa  = rol == "empresa"
get isCliente  = rol == "cliente"
# Empleado de gestión = trabaja en la oficina (rol empresa) pero NO es el dueño.
get isGestion  = rol == "empresa" and not isOwner
# Ve cobros y reportes: el dueño, o la oficina con el permiso que el dueño le dio.
get verFinanzas = isOwner or finanzas

# Guards de portal: rol correcto Y sesión activa (los usa app.muten en las rutas link-based).
get canWalker   = loggedIn and rol == "paseador"
get canBusiness = loggedIn and rol == "empresa"
get canClient   = loggedIn and rol == "cliente"

action setSession(s: Session) mutates loggedIn, userId, userName, rol, negocioId, isOwner, authError {
  loggedIn.set(s.loggedIn)
  userId.set(s.userId)
  userName.set(s.userName)
  rol.set(s.rol)
  negocioId.set(s.negocioId)
  isOwner.set(s.isOwner)
  authError.set("")
}

action setError(msg: text) mutates authError { authError.set(msg) }
action setFinanzas(on: bool) mutates finanzas { finanzas.set(on) }

action logout mutates loggedIn, userId, userName, rol, negocioId, isOwner, authError, finanzas {
  finanzas.set(false)
  signOut()
  loggedIn.set(false)
  userId.set("")
  userName.set("")
  rol.set("")
  negocioId.set("")
  isOwner.set(false)
  authError.set("")
}
