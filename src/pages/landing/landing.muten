screen landing

# Reseñas reales (ResenasBridge → resenas_publicas): aprobadas por cada negocio y con nombre consentido.
entity ResenaPub { autor text  rating number  texto text  negocio text  fecha text }
state {
  rvTotal    = 0 : number
  rvPromedio = "" : text
  rvItems    = [] : list<ResenaPub>
}
action rvSetTotal(n: number) mutates rvTotal { rvTotal.set(n) }
action rvSetPromedio(p: text) mutates rvPromedio { rvPromedio.set(p) }
action rvSetItems(rows: list<ResenaPub>) mutates rvItems { rvItems.set(rows) }

# Hero: corte diagonal + medalla giratoria + collage de stickers (concepto 04).
Page class("lp2") {
  Stack class("dc-hero") {
    Stack class("dc-grid") {

      # ---- lado izquierdo: texto ----
      Stack class("dc-left") {
        Image "/devdogs-wordmark.png" alt("DevDogs") class("dc-logo")
        Stack class("dc-eye") { Span "Gestión de paseos" }
        Stack class("dc-h") {
          Span "Domina tus "
          Span "paseos." class("dc-acc")
        }
        Text "Agenda tus salidas, lleva la ficha de cada perro y cierra las cuentas del mes." class("dc-sub")
        Stack class("dc-cta") {
          Link "Empezar gratis" -> "/signup" class("dc-ctabtn")
          Text "Sin tarjeta — tu cuenta queda lista en segundos." class("dc-ctanote")
        }
        Stack class("dc-stats") {
          Stack class("dc-stat") { Span "0$"     class("dc-statn")  Span "para empezar" class("dc-statk") }
        }
      }

      # ---- lado derecho: foto en diagonal + stickers ----
      Stack class("dc-right") {
        Stack class("dc-photo") {}

        Stack class("dc-sticker dc-k1") {
          Stack class("dc-chip-ic") { Icon "lucide:check" }
          Stack class("dc-chip-body") {
            Span "Rocky entregado" class("dc-chip-t")
            Span "16:42 · El Poblado" class("dc-chip-s")
          }
        }

        Stack class("dc-sticker dc-k2") {
          Stack class("dc-chip-ic") { Icon "lucide:map-pin" }
          Stack class("dc-chip-body") {
            Span "3 perros en paseo" class("dc-chip-t")
            Span "Grupo mañana" class("dc-chip-s")
          }
        }

        Stack class("dc-sticker dc-k3 dc-mini") {
          Stack class("dc-mini-box") { Span "LUNA & TOBY" }
          Stack class("dc-mini-cap") {
            Span "Salida de la tarde" class("dc-chip-t")
            Span "Recibido 08:15" class("dc-chip-s")
          }
        }

        Stack class("dc-sticker dc-k4 dc-tag") {
          Icon "lucide:repeat"
          Span "Recurrentes"
        }
      }

      # ---- medalla giratoria (centro exacto del hero) ----
      Stack class("dc-medal") {
        Image "/dc-medal.svg" alt("") class("dc-medal-ring")
        Stack class("dc-medal-mid") {
          Stack class("dc-medal-btn") { Icon "lucide:arrow-right" }
        }
      }
    }
  }

  # ===== Servicios (cinemático · fondo mango · 3 cartas largas) =====
  Stack class("sv") {
    Stack class("sv-wave-t") {}
    Stack class("sv-wave") {}
    Stack class("sv-head") {
      Stack class("sv-eye") { Icon "lucide:plus"  Span "Para tu negocio" }
      Stack class("sv-h") {
        Span "¿Qué ofrece "
        Span "tu negocio" class("sv-acc")
        Span "?"
      }
      Text "Organiza cada servicio según la energía y el carácter de cada perro. Todo queda registrado: la entrega, las fotos y el cobro." class("sv-sub")
    }

    Stack class("sv-grid") {

      Link "" -> "/signup" class("sv-card") {
        Stack class("sv-photo sv-hosp") {}
        Stack class("sv-scrim") {}
        Span " · Guardería" class("sv-fototag")
        Stack class("sv-cb") {
          Image "/Boarding.svg" alt("") class("sv-ic")
          Span "Guardería" class("sv-ct")
          Text "Registra los días de guardería de cada perro y deja su cobro listo al finalizar." class("sv-cd")
          Stack class("sv-more") { Span "Empezar"  Icon "lucide:arrow-up-right" }
        }
      }

      Link "" -> "/signup" class("sv-card") {
        Stack class("sv-photo sv-paseo") {}
        Stack class("sv-scrim") {}
        Span "· Paseos caninos" class("sv-fototag")
        Stack class("sv-cb") {
          Image "/Walking.svg" alt("") class("sv-ic")
          Span "Paseos caninos" class("sv-ct")
          Text "Arma los grupos de cada día. El paseador marca la recogida y la entrega, y sube fotos para el dueño." class("sv-cd")
          Stack class("sv-more") { Span "Empezar"  Icon "lucide:arrow-up-right" }
        }
      }

      Link "" -> "/signup" class("sv-card") {
        Stack class("sv-photo sv-adies") {}
        Stack class("sv-scrim") {}
        Span " · Adiestramiento" class("sv-fototag")
        Stack class("sv-cb") {
          Image "/Daycare.svg" alt("") class("sv-ic")
          Span "Adiestramiento" class("sv-ct")
          Text "Agenda las sesiones de cada perro y lleva su historial y su comportamiento en su ficha." class("sv-cd")
          Stack class("sv-more") { Span "Empezar"  Icon "lucide:arrow-up-right" }
        }
      }
    }

    Stack class("sv-proof") {
      Stack class("sv-proof-eye") { Icon "lucide:plus"  Span "Todo en un solo lugar" }
      Stack class("sv-proof-h") {
        Span "Paseos, guardería," class("sv-proof-l")
        Span "baño y adiestramiento." class("sv-proof-l")
        Stack class("sv-proof-l") {
          Span "todo tu "
          Span "negocio" class("sv-proof-acc")
        }
        Span "en un solo lugar." class("sv-proof-l sv-proof-acc")
      }
      Link "Crear cuenta gratis" -> "/signup" class("sv-cta-btn sv-proof-btn")
    }
  }

  # ===== Agenda del negocio (Luxe · blanco · serif · líneas finas · detalles uva) =====
  Section class("ag") {
    Stack class("ag-grid") {

      # ---- izquierda: agenda del día + números ----
      Stack class("ag-left") {
        Stack class("ag-day") {
          Stack class("ag-row") {
            Span "8:00" class("ag-t")
            Stack class("ag-main") {
              Stack class("ag-who") { Span "Rocky — Cliente" class("ag-nm")  Span "Paseo" class("ag-sv") }
              Span "$8.000" class("ag-pr")
            }
          }
          Stack class("ag-row") {
            Span "9:00" class("ag-t")
            Stack class("ag-main") {
              Span "Libre hasta las 10:00" class("ag-free")
              Stack class("ag-dot") {}
            }
          }
          Stack class("ag-row") {
            Span "10:00" class("ag-t")
            Stack class("ag-main") {
              Stack class("ag-who") { Span "Luna & Toby — Cliente" class("ag-nm")  Span "Guardería" class("ag-sv") }
              Span "$18.000" class("ag-pr")
            }
          }
          Stack class("ag-row") {
            Span "12:00" class("ag-t")
            Stack class("ag-main") {
              Stack class("ag-who") { Span "Pelusa — Cliente" class("ag-nm")  Span "Baño" class("ag-sv") }
              Span "sin cobrar" class("ag-pr ag-pr-soft")
            }
          }
          Stack class("ag-row") {
            Span "2:00" class("ag-t")
            Stack class("ag-main") {
              Stack class("ag-who") { Span "Thor — Cliente" class("ag-nm")  Span "Adiestramiento" class("ag-sv") }
              Span "$15.000" class("ag-pr")
            }
          }
        }

        Stack class("ag-stats") {
          Stack class("ag-stat") { Span "$430.000" class("ag-sn")  Span "Cobrado este mes" class("ag-sk") }
          Stack class("ag-stat") { Span "$48.000" class("ag-sn")  Span "Sin cobrar" class("ag-sk") }
          Stack class("ag-stat") { Span "Paseo grupal" class("ag-sn ag-sn-sm")  Span "Lo más pedido" class("ag-sk") }
        }
        Text "Ejemplo ilustrativo con datos ficticios." class("ag-note")
      }

      # ---- derecha: copy ----
      Stack class("ag-copy") {
        Span "Y del otro lado" class("ag-eye")
        Stack class("ag-h") {
          Span "Tu día, sin tener que "
          Span "armarlo" class("ag-acc")
        }
        Text "Abres la app y ya está hecho: qué perro sale, a qué hora, cuánto cuesta y qué falta por cobrar. Los números salen de los servicios realizados; no hay nada que cargar a mano." class("ag-sub")
      }
    }
  }

  # ===== Por qué DevDogs (imagen recortada + 3 pilares) =====
  Section class("pq") {
    Stack class("pq-grid") {

      Stack class("pq-img") {
        Stack class("pq-blob") {}
        Stack class("pq-deco pq-deco1") { Icon "lucide:paw-print" }
        Stack class("pq-deco pq-deco2") { Icon "lucide:heart" }
      }

      Stack class("pq-copy") {
        Stack class("pq-head") {
          Span "Sobre nosotros" class("pq-eye")
          Stack class("pq-h") {
            Span "¿Por qué "
            Span "DevDogs" class("pq-acc")
            Span "?"
          }
          Text "Todo lo que necesitas para gestionar tus paseos, clientes y cobros, en un solo lugar." class("pq-sub")
        }

        Stack class("pq-items") {
          Stack class("pq-item") {
            Stack class("pq-ic") { Icon "lucide:camera" }
            Stack class("pq-txt") {
              Span "Todo registrado" class("pq-it")
              Text "El paseador marca la recogida y la entrega y sube fotos del paseo. El dueño ve el estado y las fotos de su perro." class("pq-id")
            }
          }
          Stack class("pq-item") {
            Stack class("pq-ic") { Icon "lucide:calendar-check" }
            Stack class("pq-txt") {
              Span "Agenda automática" class("pq-it")
              Text "Abres la app y ya está: qué perros salen hoy, a qué hora y en qué grupo. Sin armar nada a mano." class("pq-id")
            }
          }
          Stack class("pq-item") {
            Stack class("pq-ic") { Icon "lucide:wallet" }
            Stack class("pq-txt") {
              Span "Cuentas claras" class("pq-it")
              Text "Cobros por servicio, estado de cuenta por perro y cierre de mes. Sin planillas ni WhatsApp." class("pq-id")
            }
          }
        }
      }
    }
  }

  # ===== Reseñas (solo reales; el servidor no devuelve nada con menos de 3, y entonces no se muestra) =====
  Custom ResenasBridge on(total: rvSetTotal, promedio: rvSetPromedio, items: rvSetItems)
  when rvTotal >= 3 {
    Section class("rv") {
      Stack class("rv-wave-t") {}
      Stack class("rv-head") {
        Stack class("rv-headl") {
          Stack class("rv-eye") { Icon "lucide:heart-handshake"  Span "Lo que dicen los clientes" }
          Stack class("rv-h") {
            Span "{rvPromedio} de 5 "
            Span "· {rvTotal} reseñas" class("rv-acc")
          }
          Text "Opiniones de clientes con al menos un servicio finalizado, aprobadas por cada negocio." class("rv-sub")
        }
      }
      List class("rv-grid") {
        each rvItems as r {
          Article class("rv-card") {
            Stack class("rv-stars") aria(label: "{r.rating} de 5 estrellas") {
              Icon "lucide:star"
              Icon "lucide:star" class("rv-off" when r.rating < 2)
              Icon "lucide:star" class("rv-off" when r.rating < 3)
              Icon "lucide:star" class("rv-off" when r.rating < 4)
              Icon "lucide:star" class("rv-off" when r.rating < 5)
              Span "{r.rating}/5" class("rv-score")
            }
            Text "{r.texto}" class("rv-body")
            Stack class("rv-foot") {
              Stack class("rv-av") { Span "{initial(r.autor)}" }
              Stack class("rv-fx") {
                Span "{r.autor}" class("rv-nm")
                Span "{r.negocio} · {r.fecha}" class("rv-role")
              }
            }
          }
        }
      }
    }
  }

  # ===== Cómo empezar (tres pasos reales; DevDogs no es un buscador de prestadores) =====
  Section class("bs") {
    Stack class("bs-head") {
      Span "Así de simple" class("bs-eye")
      Title "Empieza en tres pasos" h2 class("bs-h")
      Text "Crea la cuenta de tu negocio, arma tu catálogo e invita a tus clientes con un código." class("bs-sub")
    }

    Stack class("bs-bar") {
      Stack class("bs-field") {
        Icon "lucide:user-plus" class("bs-fic")
        Stack class("bs-ftx") {
          Span "Paso 1" class("bs-flabel")
          Span "Crea tu cuenta" class("bs-fval")
        }
      }
      Stack class("bs-div") {}
      Stack class("bs-field") {
        Icon "lucide:list-checks" class("bs-fic")
        Stack class("bs-ftx") {
          Span "Paso 2" class("bs-flabel")
          Span "Arma tu catálogo" class("bs-fval")
        }
      }
      Stack class("bs-div") {}
      Stack class("bs-field") {
        Icon "lucide:send" class("bs-fic")
        Stack class("bs-ftx") {
          Span "Paso 3" class("bs-flabel")
          Span "Invita a tus clientes" class("bs-fval")
        }
      }
      Link "" -> "/signup" class("bs-btn") {
        Icon "lucide:arrow-right"
        Span "Empezar"
      }
    }

    Stack class("bs-wave-b") {}
  }

  # ===== Pre-footer (CTA + perro que sobresale — ref Pet Shop) =====
  Section class("pf") {

    Stack class("pf-grid") {
      # ---- izquierda: título + form ----
      Stack class("pf-copy") {
        Stack class("pf-h") {
          Span "¿Listo para "
          Span "empezar?" class("pf-acc")
        }
        Text "Crea tu cuenta gratis y prueba DevDogs con tu negocio." class("pf-sub")

        Stack class("pf-form") {
          Link "Crear cuenta" -> "/signup" class("pf-btn")
        }
      }

      # ---- derecha: perro que sobresale ----
      Stack class("pf-dog") {
        Image "/footer-dog.png" alt("") class("pf-dogimg")
      }
    }
  }

  # ===== Footer (claro: marca centrada + 3 columnas + foto del parque al pie) =====
  Footer class("gf") {
    Span "DEVDOGS" class("gf-giant") aria(hidden: true)
    Image "/footer-hills.jpg" alt("") class("gf-scene")

    Stack class("gf-logo") {
      Image "/devdogs-mark.png" alt("") class("gf-mark")
      Image "/devdogs-wordmark.png" alt("DevDogs") class("gf-wordmark")
    }
    
    Span "Medellín, Antioquia, Colombia" class("gf-addr")

    Span "" class("gf-rule")

    Stack class("gf-cols") {
      Nav class("gf-col") aria(label: "Servicios") {
        Span "Servicios" class("gf-colh")
        Link "Paseos" -> "/signup" class("gf-link")
        Link "Guardería" -> "/signup" class("gf-link")
        Link "Baño y corte" -> "/signup" class("gf-link")
        Link "Adiestramiento" -> "/signup" class("gf-link")
      }
      Nav class("gf-col") aria(label: "Cuenta") {
        Span "Cuenta" class("gf-colh")
        Link "Iniciar sesión" -> "/login" class("gf-link")
        Link "Registrarse" -> "/signup" class("gf-link")
        Link "Unirme con código" -> "/unirse" class("gf-link")
        Link "Contacto" -> "/privacidad#derechos" class("gf-link")
      }
      Nav class("gf-col") aria(label: "DevDogs") {
        Span "DevDogs" class("gf-colh")
        Link "Qué es DevDogs" -> "/politicas#terminos" class("gf-link")
        Link "Política de privacidad" -> "/privacidad" class("gf-link")
        Link "Términos y políticas" -> "/politicas" class("gf-link")
      }
    }

    Span "© 2026 DevDogs — Todos los derechos reservados" class("gf-copy")
  }
}
