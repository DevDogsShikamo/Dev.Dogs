{
  "name": "muten-app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "muten dev",
    "build": "muten bundle",
    "lint": "muten lint",
    "test": "npm run test:security",
    "test:security": "node --test --test-concurrency=1 tests/security/",
    "test:client": "node --test tests/client/",
