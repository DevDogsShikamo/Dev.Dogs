screen estadisticas
use cop from "~/lib/money.ts"

Page class("screen gap-lg") {
  Stack class("gap-xs") {
    Text "Estadísticas" class("t-xl black")
    Text "Resumen de la semana" class("muted")
  }

  Stack class("grid grid-3") {
    Stack class("card kpi") { Span "Ingresos semana" class("kpi-l")  Text "{cop(estadisticas.ingresoSemana)}" class("kpi-n") }
    Stack class("card kpi") { Span "Servicios vendidos" class("kpi-l")  Text "{estadisticas.serviciosVendidos}" class("kpi-n") }
    Stack class("card kpi") { Span "Clientes" class("kpi-l")  Text "{empresa.info.clientes}" class("kpi-n") }
  }

  Stack class("card pad-lg gap-md") {
    Title "Ingresos por día" h2 class("bold t-md")
    Chart @estadisticas.ingresosSemana kind(bar) x(dia) y(monto)
  }

  Stack class("card pad-lg gap-md") {
    Title "Servicios más vendidos" h2 class("bold t-md")
    Chart @estadisticas.topServicios kind(donut) x(servicio) y(ventas)
  }
}
