screen servicios
use cop from "~/lib/money.ts"

Page class("screen gap-lg") {
  Stack class("hero-band row between center") {
    Stack class("gap-xs") {
      Text "{empresa.info.nombre}" class("t-lg black")
      Text "{servicios.activos} servicios activos · desde {cop(servicios.precioMin)}" class("t-sm")
    }
    Stack class("avatar-lg") { Icon "lucide:sparkles" }
  }

  Stack class("row between center") {
    Title "Servicios" h2 class("bold t-lg")
    Span "{servicios.count} en total" class("muted t-sm")
  }

  Stack class("grid grid-2") {
    each servicios.items as s {
      Article class("card svc") {
        Stack class("row between center") {
          Stack class("svc-ic") { Text "{s.emoji}" class("t-lg") }
          when s.activo { Span "Activo" class("badge badge-paid") }
          when not s.activo { Span "Pausado" class("badge badge-unpaid") }
        }
        Text "{s.nombre}" class("bold t-md")
        Text "{s.desc}" class("muted t-sm")
        Stack class("row between center") {
          Text "{cop(s.precio)}" class("price accent")
          Span "{s.duracion} min" class("chip")
        }
        when s.activo { Button "Pausar" -> servicios.toggle(s.id, s.activo) class("btn-ghost btn-block") }
        when not s.activo { Button "Activar" -> servicios.toggle(s.id, s.activo) class("btn btn-block") }
      }
    }
  }
}
