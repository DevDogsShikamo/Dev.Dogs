# Servicios del negocio (oferta + precios). Solo la LISTA (lectura).
# Datos in: bridge ServiciosBridge. El form vive en la página (dashboard.muten).
entity Servicio {
  id       text
  nombre   text
  tipo     text
  duracion number
  precio   number
  modelo   text
}

state {
  servicios = [] : list<Servicio> persist
  zonas     = [] : list<text> persist
}

get total = servicios.length

action setServicios(rows: list<Servicio>) mutates servicios { servicios.set(rows) }
action setZonas(rows: list<text>) mutates zonas { zonas.set(rows) }

# ---- Optimistas (la UI responde al instante; data.ts persiste + revierte si falla).
action servicioUpd(pid: text, nnombre: text, ntipo: text, nduracion: number, nprecio: number, nmodelo: text) mutates servicios {
  servicios.patch where id == pid with { nombre: nnombre, tipo: ntipo, duracion: nduracion, precio: nprecio, modelo: nmodelo }
}
action servicioDel(pid: text) mutates servicios { servicios.remove where id == pid }
# Limpia el cache al hacer logout (in-memory + persist).
action limpiar mutates servicios, zonas { servicios.reset()  zonas.reset() }
