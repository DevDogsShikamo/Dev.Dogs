screen completar
use okPhone from "../../components/validate.js"
use politicaVersion, alFinal from "~/lib/politica.js"

# /completar-registro: a signed-in user without a profile (first Google login, or a signup whose
# provisioning failed). The profile is created by the same RPCs as the email signup and /unirse
# (provision_negocio / redeem_invite) with the accepted policy version; then SupaAuthForm reports the
# session again and the guard chain lands in the portal of the role.

state {
  opcion   = "" : text   # EMPRESA | PASEADOR | CODIGO
  nombre   = "" : text
  telefono = "" : text
  negocio  = "" : text
  codigo   = "" : text
  acepta   = false : bool
  verPol = false : bool
  leido  = false : bool
  nonce    = 0 : number
}

get phoneOk = telefono.length == 0 or okPhone(telefono)
get valido = nombre.length > 1 and acepta and phoneOk and (opcion == "PASEADOR" or (opcion == "EMPRESA" and negocio.length > 1) or (opcion == "CODIGO" and codigo.length > 12))
# The version travels to the server only after the policy is accepted in the modal.
get version = politicaVersion()
get politicaAceptada = acepta ? politicaVersion() : ""

action pick(o: text) mutates opcion { opcion.set(o) }
action enviar mutates nonce { nonce.set(nonce + 1) }
action abrirPol mutates verPol { verPol.set(true) }
action cerrarPol mutates verPol { verPol.set(false) }
action leerPol mutates leido { if alFinal("dd-politica-doc") { leido.set(true) } }
action aceptarPol mutates acepta, verPol { acepta.set(true) verPol.set(false) }

Page class("glogin") {

  Stack class("glogin-photo") {
    Stack class("glogin-back") {
      Image "/devdogs-wordmark.png" alt("DevDogs") class("gback-wm")
    }
    Stack class("glogin-photo-in") {
      Title "Ya casi terminas." h1 class("glogin-h")
      Text "Cuéntanos cómo vas a usar DevDogs y crearemos tu perfil." class("glogin-sub")
    }
  }

  Stack class("glogin-form") {
    Stack class("gform-body") {
      Title "Completar registro" h2 class("pv-h1")
      when auth.baja {
        Text "Ya no perteneces a ningún negocio. Para volver, pide una nueva invitación con tu correo o crea tu propio negocio." class("gerror")
      }

      Stack class("su-roles") {
        Button -> pick("EMPRESA") class("su-role") class("su-role-on" when opcion == "EMPRESA") {
          Stack class("su-role-ic") { Icon "lucide:building-2" }
          Span "Tengo un negocio" class("su-role-name")
        }
        Button -> pick("PASEADOR") class("su-role") class("su-role-on" when opcion == "PASEADOR") {
          Stack class("su-role-ic") { Icon "lucide:footprints" }
          Span "Soy paseador independiente" class("su-role-name")
        }
        Button -> pick("CODIGO") class("su-role") class("su-role-on" when opcion == "CODIGO") {
          Stack class("su-role-ic") { Icon "lucide:ticket" }
          Span "Tengo un código de invitación" class("su-role-name")
        }
      }

      # A dog owner joins only through an invitation of their business, never by creating one.
      when opcion != "CODIGO" {
        Text "¿Eres dueño de un perro? DevDogs es la herramienta que usa tu negocio de cuidado de perros: pídele que te invite con un código o un link de invitación." class("muted t-sm")
      }

      when opcion != "" {
        Stack class("su-fields") {
          Stack class("gfield") {
            Stack class("gfield-ic") { Icon "lucide:user" }
            Stack class("gfield-body") {
              Text "Tu nombre" class("gfield-label")
              SearchField bind(nombre) "Ana Rondón" class("gfield-input")
            }
          }
          when opcion == "EMPRESA" {
            Stack class("gfield") {
              Stack class("gfield-ic") { Icon "lucide:store" }
              Stack class("gfield-body") {
                Text "Nombre del negocio" class("gfield-label")
                SearchField bind(negocio) "DevDogs Poblado" class("gfield-input")
              }
            }
          }
          when opcion != "CODIGO" {
            Stack class("gfield") class("gfield-err" when not phoneOk) {
              Stack class("gfield-ic") { Icon "lucide:phone" }
              Stack class("gfield-body") {
                Text "Tu teléfono (opcional)" class("gfield-label")
                SearchField bind(telefono) "+57 300 000 0000" class("gfield-input")
              }
              when not phoneOk { Text "Nº inválido" class("gfield-hint") }
            }
          }
          when opcion == "CODIGO" {
            Stack class("gfield") {
              Stack class("gfield-ic") { Icon "lucide:ticket" }
              Stack class("gfield-body") {
                Text "Código de invitación" class("gfield-label")
                SearchField bind(codigo) "XXXXXXX-XXXXXXX" class("gfield-input")
              }
            }
          }
          when opcion == "CODIGO" {
            Text "La invitación debe ser para el mismo correo con el que iniciaste sesión." class("muted t-sm")
          }
        }
      }

      Consentimiento(aceptado: acepta, abierto: verPol, leido: leido, version: version, onAbrir: abrirPol, onCerrar: cerrarPol, onLeer: leerPol, onAceptar: aceptarPol)

      when auth.authError.length > 0 { Text "{auth.authError}" class("gerror") }

      Stack class("gsignup") {
        Button "Cerrar sesión" -> auth.logout class("glink t-sm")
      }
    }

    Stack class("gbar") {
      Button -> enviar class("gbar-cta") disabled when not valido {
        Span "Completar registro"
        Icon "lucide:arrow-right"
      }
    }

    Custom SupaAuthForm inputs(mode: "completar", rol: @opcion, nombre: @nombre, telefono: @telefono, negocioNombre: @negocio, codigo: @codigo, politica: @politicaAceptada, nonce: @nonce) on(failed: auth.setError, session: auth.setSession)
  }
}
