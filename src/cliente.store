# Estado del portal CLIENTE (dueño del perro). Datos in: ClienteBridge.
# Sus perros (perro_duenos → perros), sus paseos (prestaciones), y las salidas
# disponibles del negocio para reservar (grupos).
entity PerroMio  { id text  nombre text  raza text  tamano text  foto text }
entity PaseoMio  { id text  fecha text  hora text  servicio text  estado text  perro text  cuidador text  futuro bool }
entity SalidaDisp { id text  zona text  hora text  servicio text  servicioId text  cuidadorId text  tipo text }

state {
  misPerros = [] : list<PerroMio>
  misPaseos = [] : list<PaseoMio>
  salidas   = [] : list<SalidaDisp>
}

get nPerros    = misPerros.length
get proximos   = misPaseos.count where futuro

action setMisPerros(rows: list<PerroMio>) mutates misPerros { misPerros.set(rows) }
action setMisPaseos(rows: list<PaseoMio>) mutates misPaseos { misPaseos.set(rows) }
action setSalidas(rows: list<SalidaDisp>) mutates salidas { salidas.set(rows) }
