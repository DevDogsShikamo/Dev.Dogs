# Consent line + modal with the full legal documents (terms of use + data policy, one version). "Acepto"
# stays disabled until the reader scrolls them to the end (DocModal; onLeer flips `leido` once it does).
part Consentimiento(aceptado: bool, abierto: bool, leido: bool, version: text, onAbrir: action, onCerrar: action, onLeer: action, onAceptar: action) {
  Stack class("gconsent") {
    Button -> $onAbrir class("gconsent-line") class("gconsent-ok" when $aceptado) {
      when $aceptado { Icon "lucide:square-check" }
      when not $aceptado { Icon "lucide:square" }
      when $aceptado { Span "Aceptaste los Términos y la Política de tratamiento de datos" }
      when not $aceptado { Span "Leer y aceptar los Términos y la Política de tratamiento de datos" }
    }

    when $abierto {
      DocModal(titulo: "Términos y Política de tratamiento de datos", aceptar: "Acepto los Términos y la Política de tratamiento de datos", leido: $leido, onCerrar: $onCerrar, onLeer: $onLeer, onAceptar: $onAceptar) {
        DocumentosLegales(version: $version)
      }
    }
  }
}
