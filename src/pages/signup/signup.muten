screen signup

use okPhone from "../../components/validate.js"
use okPw from "../../components/validate.js"

state {
  step      = 0 : number
  rol       = "" : text
  nombre    = "" : text
  telefono  = "" : text
  email     = "" : text
  pw        = "" : text
  negocio   = "" : text
  nonce     = 0  : number
  menuOpen  = false : boolean
}

action toggleMenu mutates menuOpen { menuOpen.set(not menuOpen) }

get phoneOk  = okPhone(telefono)
get pwOk     = okPw(pw)

get validStep = (step == 0 and rol != "") or (step == 1 and nombre.length > 1 and phoneOk and email.length > 4 and pwOk)

action pick(r: text) mutates rol { rol.set(r) }
action next mutates step { step.set(step + 1) }
action back mutates step { step.set(step - 1) }
action finish mutates nonce { nonce.set(nonce + 1) }

Page class("su") {

  Stack class("su-scene") {
    Span "" class("su-photo")

    Stack class("su-topbar") {
      Button -> toggleMenu class("su-nbtn") {
        Span "☰" class("su-nbtn-open")
        Span "✕" class("su-nbtn-close")
      }
    }

    when menuOpen {
      Stack class("su-menu") {
        Link "Inicio" -> "/" class("su-menu-link")
        Link "Iniciar sesión" -> "/login" class("su-menu-link")
        Span "Registrarse" class("su-menu-link su-menu-active")
      }
    }
    Image "/shoes.png" alt("Sneakers") class("su-shoes")
  }

  Stack class("su-content") {
    Stack class("su-left") {
      Title "Pasea tu perro" h2 class("su-hero-h")
      Title "Cuida tu manada" h2 class("su-hero-h su-hero-bold")
      Text "Cuidado y paseo profesional para tu mascota." class("su-hero-sub")
    }

    Stack class("su-right") {
      when step == 0 {
        Stack class("su-step") {
          Stack class("su-roles") {
            Button -> pick("PASEADOR") class("su-role") class("su-role-on" when rol == "PASEADOR") {
              Stack class("su-role-ic") { Icon "lucide:footprints" }
              Span "Paseador" class("su-role-name")
            }
            Button -> pick("EMPRESA") class("su-role") class("su-role-on" when rol == "EMPRESA") {
              Stack class("su-role-ic") { Icon "lucide:building-2" }
              Span "Empresa" class("su-role-name")
            }
            Link "" -> "/unirse" class("su-role") {
              Stack class("su-role-ic") { Icon "lucide:heart" }
              Span "Dueño" class("su-role-name")
            }
          }
          Stack class("su-step-foot") {
            Stack class("gsignup") {
              Text "¿Ya tienes cuenta?" class("muted t-sm")
              Link "Inicia sesión" -> "/login" class("glink t-sm")
            }
            Button -> next class("su-cta") disabled when not validStep { Span "Unirme hoy" }
          }
        }
      }

      when step == 1 {
        Stack class("su-step") {
          Stack class("su-fields") {
            Stack class("gfield") {
              Stack class("gfield-ic") { Icon "lucide:user" }
              Stack class("gfield-body") {
                Text "Tu nombre" class("gfield-label")
                SearchField bind(nombre) "Ana Rondón" class("gfield-input")
              }
            }
            Stack class("gfield") class("gfield-err" when telefono.length > 0 and not phoneOk) {
              Stack class("gfield-ic") { Icon "lucide:phone" }
              Stack class("gfield-body") {
                Text "Tu teléfono" class("gfield-label")
                SearchField bind(telefono) "+57 300 000 0000" class("gfield-input")
              }
              when telefono.length > 0 and not phoneOk {
                Text "Nº inválido" class("gfield-hint")
              }
            }
            Stack class("gfield") {
              Stack class("gfield-ic") { Icon "lucide:mail" }
              Stack class("gfield-body") {
                Text "Tu correo" class("gfield-label")
                SearchField bind(email) "tu@correo.com" class("gfield-input")
              }
            }
            Stack class("gfield") class("gfield-err" when pw.length > 0 and not pwOk) {
              Stack class("gfield-ic") { Icon "lucide:lock" }
              Stack class("gfield-body") {
                Text "Contraseña" class("gfield-label")
                Password bind(pw) "••••••••" class("gfield-input")
              }
              when pw.length > 0 and not pwOk {
                Text "Usa mayúscula y número" class("gfield-hint")
              }
            }
            Stack class("gfield") {
              Stack class("gfield-ic") { Icon "lucide:store" }
              Stack class("gfield-body") {
                Text "Nombre del negocio (opcional)" class("gfield-label")
                SearchField bind(negocio) "DevDogs Poblado" class("gfield-input")
              }
            }
          }
          Stack class("su-nav") {
            Button -> back class("su-back") aria(label: "Atrás") { Icon "lucide:arrow-left" }
            Button -> finish class("su-cta") disabled when not validStep { Span "Crear mi cuenta" }
          }
        }
      }

      when auth.authError.length > 0 { Text "{auth.authError}" class("gerror") }
    }
  }

  Stack class("su-bottom") {
    Stack class("su-bot-left") {
      Span "Registro gratuito" class("su-bot-badge")
    }
    Stack class("su-bot-mid") {
      Stack class("su-avs") {
        Span "D" class("su-av")
        Span "M" class("su-av")
        Span "A" class("su-av")
        Span "+" class("su-av")
      }
      Span "500+ dueños confían"
    }
    Stack class("su-bot-right") {
      Icon "lucide:shield-check"
      Span "Datos protegidos"
    }
  }

  Custom SupaAuthForm inputs(mode: "signup", email: @email, pw: @pw, nombre: @nombre, telefono: @telefono, rol: @rol, negocioNombre: @negocio, nonce: @nonce) on(failed: auth.setError, session: auth.setSession)
}
