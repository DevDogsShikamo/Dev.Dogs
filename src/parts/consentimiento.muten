# Consent line + modal with the full legal documents (terms of use + data policy, one version). "Acepto"
# stays disabled until the reader scrolls them to the end (onLeer runs on every scroll of the body and
# flips `leido` once it reaches it).
part Consentimiento(aceptado: bool, abierto: bool, leido: bool, version: text, onAbrir: action, onCerrar: action, onLeer: action, onAceptar: action) {
  Stack class("gconsent") {
    Button -> $onAbrir class("gconsent-line") class("gconsent-ok" when $aceptado) {
      when $aceptado { Icon "lucide:square-check" }
      when not $aceptado { Icon "lucide:square" }
      when $aceptado { Span "Aceptaste los Términos y la Política de tratamiento de datos" }
      when not $aceptado { Span "Leer y aceptar los Términos y la Política de tratamiento de datos" }
    }

    when $abierto {
      Stack class("pm-overlay") {
        Stack class("pm-panel") aria(role: "dialog", modal: true, label: "Términos y Política de tratamiento de datos") {
          Stack class("pm-head") {
            Span "Términos y Política de tratamiento de datos" class("pm-title")
            Button -> $onCerrar class("pm-x") aria(label: "Cerrar los documentos") { Icon "lucide:x" }
          }
          Stack id("dd-politica-doc") class("pm-body") on(scroll: $onLeer) {
            DocumentosLegales(version: $version)
          }
          Stack class("pm-foot") {
            # `disabled when` does not take part params, so the locked and unlocked buttons are two branches.
            when not $leido {
              Stack class("pm-foot-in") {
                Text "Desplázate hasta el final del documento para poder aceptar." class("pm-hint")
                Button "Acepto los Términos y la Política de tratamiento de datos" class("pm-ok") disabled
              }
            }
            when $leido { Button "Acepto los Términos y la Política de tratamiento de datos" -> $onAceptar class("pm-ok") }
          }
        }
      }
    }
  }
}
