screen dashboard

# Role-aware home. One route, content switches by the profile rol (Fase 1 skeletons).
Page class("screen gap-lg") {
  Stack class("gap-xs") {
    Text "¡Hola, {auth.userName}!" class("t-xl black")
    when auth.slug.length > 0 { Text "Tu link: devdogs.co/{auth.slug}" class("muted t-sm") }
  }

  # ---- PASEADOR ----
  when auth.isPaseador {
    Stack class("hero-band gap-xs") {
      Text "Portal Paseador" class("black t-lg")
      Text "Acá vas a ver tus perros del día, recibir/entregar y confirmar." class("t-sm")
    }
    Stack class("grid grid-2 gap-md") {
      Stack class("card pad-lg gap-xs") { Icon "lucide:calendar-check" class("accent")  Text "Mi día" class("bold")  Text "Perros programados" class("muted t-sm") }
      Stack class("card pad-lg gap-xs") { Icon "lucide:footprints" class("accent")  Text "Confirmación" class("bold")  Text "Quiénes salieron" class("muted t-sm") }
    }
    Text "🚧 En construcción — Fase 2" class("muted t-sm text-center")
  }

  # ---- EMPRESA ----
  when auth.isEmpresa {
    Stack class("hero-band gap-xs") {
      Text "Portal Empresa" class("black t-lg")
      Text "Tu equipo, tus grupos de paseo, clientes y pagos." class("t-sm")
    }
    Stack class("grid grid-2 gap-md") {
      Stack class("card pad-lg gap-xs") { Icon "lucide:users" class("accent")  Text "Paseadores" class("bold")  Text "Equipo y asignación" class("muted t-sm") }
      Stack class("card pad-lg gap-xs") { Icon "lucide:layers" class("accent")  Text "Grupos" class("bold")  Text "Agrupar perros" class("muted t-sm") }
      Stack class("card pad-lg gap-xs") { Icon "lucide:wallet" class("accent")  Text "Pagos" class("bold")  Text "Cobros y salarios" class("muted t-sm") }
      Stack class("card pad-lg gap-xs") { Icon "lucide:sparkles" class("accent")  Text "Servicios" class("bold")  Text "Catálogo y precios" class("muted t-sm") }
    }
    Text "🚧 En construcción — Fase 4" class("muted t-sm text-center")
  }

  # ---- CLIENTE ----
  when auth.isCliente {
    Stack class("hero-band gap-xs") {
      Text "Portal Cliente" class("black t-lg")
      Text "Tu perro, tus paseos y tu cuenta." class("t-sm")
    }
    Stack class("grid grid-2 gap-md") {
      Stack class("card pad-lg gap-xs") { Icon "lucide:dog" class("accent")  Text "Mi mascota" class("bold")  Text "Perfil del perro" class("muted t-sm") }
      Stack class("card pad-lg gap-xs") { Icon "lucide:calendar-plus" class("accent")  Text "Agendar" class("bold")  Text "Pedir un paseo" class("muted t-sm") }
    }
    Text "🚧 En construcción — Fase 3" class("muted t-sm text-center")
  }

  # ---- perfil sin rol (aún no provisionado) ----
  when auth.rol.length == 0 {
    Stack class("card pad-lg gap-sm") {
      Text "Configurando tu cuenta…" class("bold")
      Text "Si esto no cambia en unos segundos, cerrá sesión y volvé a entrar." class("muted t-sm")
    }
  }
}
