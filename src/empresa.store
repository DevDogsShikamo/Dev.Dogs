# Company profile, backed by Supabase (table public.empresa, one row per user).
# Loaded via SupaData; edits go through data.ts saveEmpresa (upsert + refresh).
use saveEmpresa from "~/lib/data.ts"

entity Empresa {
  nombre     text required
  eslogan    text
  telefono   text
  ciudad     text
  paseadores number
  clientes   number
  perros     number
}

state {
  info = {
    nombre: "",
    eslogan: "",
    telefono: "",
    ciudad: "",
    paseadores: 0,
    clientes: 0,
    perros: 0
  } : Empresa
}

action setInfo(next: Empresa) mutates info { info.set(next) }

action save(next: Empresa) mutates info {
  info.set(next)
  saveEmpresa(next)
}
