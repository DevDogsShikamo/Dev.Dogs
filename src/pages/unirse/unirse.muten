screen unirse
use codigoDeURL from "~/lib/share.ts"
use politicaVersion, alFinal from "~/lib/politica.js"

# Canje de invitación: el invitado (paseador / cliente / gestión) crea su cuenta con
# el CÓDIGO que le compartió el negocio (atado al correo con que se registra). redeem_invite lo
# asocia al negocio con su rol y la cadena de guards de app.muten lo rutea a su portal. Es la ÚNICA
# entrada a un negocio existente: no hay unión por link/slug. No crea negocio propio.

state {
  nombre = "" : text
  email  = "" : text
  pw     = "" : text
  codigo = "" : text
  acepta = false : bool
  verPol = false : bool
  leido  = false : bool
  nonce  = 0  : number
}

get valido = nombre.length > 1 and email.length > 4 and pw.length > 5 and codigo.length > 12 and acepta
# La versión viaja al servidor solo después de aceptar la política en el modal.
get version = politicaVersion()
get politicaAceptada = acepta ? politicaVersion() : ""
action submit mutates nonce { nonce.set(nonce + 1) }
action abrirPol mutates verPol { verPol.set(true) }
action cerrarPol mutates verPol { verPol.set(false) }
action leerPol mutates leido { if alFinal("dd-politica-doc") { leido.set(true) } }
action aceptarPol mutates acepta, verPol { acepta.set(true) verPol.set(false) }

# Precarga el código si llegas por un link /unirse?codigo=XXX (al montar).
effect { codigo.set(codigoDeURL()) }

Page class("glogin") {

  Stack class("glogin-photo") {
    Stack class("glogin-back") {
      Stack class("gb-dot") { Image "/devdogs-mark.png" alt("") class("mark-white") }
      Span "DevDogs"
    }
    Stack class("glogin-photo-in") {
      Title "Te invitaron a un negocio." h1 class("glogin-h")
      Text "Ingresa el código con el mismo correo al que te invitaron y quedarás dentro del equipo." class("glogin-sub")
    }
  }

  Stack class("glogin-form") {
    Stack class("gform-body") {

      Stack class("gdiv") { Span "Únete con tu código" }

      Stack class("gfield") {
        Stack class("gfield-ic") { Icon "lucide:user" }
        Stack class("gfield-body") {
          Text "Tu nombre" class("gfield-label")
          SearchField bind(nombre) "Ana Rondón" class("gfield-input")
        }
      }

      Stack class("gfield") {
        Stack class("gfield-ic") { Icon "lucide:mail" }
        Stack class("gfield-body") {
          Text "Correo" class("gfield-label")
          SearchField bind(email) "tu@correo.com" class("gfield-input")
        }
      }

      Stack class("gfield") {
        Stack class("gfield-ic") { Icon "lucide:lock" }
        Stack class("gfield-body") {
          Text "Contraseña (mín. 6)" class("gfield-label")
          Password bind(pw) "••••••••" class("gfield-input")
        }
      }

      Stack class("gfield") {
        Stack class("gfield-ic") { Icon "lucide:ticket" }
        Stack class("gfield-body") {
          Text "Código de invitación" class("gfield-label")
          SearchField bind(codigo) "XXXXXXX-XXXXXXX" class("gfield-input")
        }
      }

      when codigo.length < 13 {
        Text "DevDogs es la herramienta que usa tu negocio de cuidado de perros. Para entrar, pídele a tu negocio que te invite: te enviará un código o un link de invitación." class("muted t-sm")
      }

      Consentimiento(aceptado: acepta, abierto: verPol, leido: leido, version: version, onAbrir: abrirPol, onCerrar: cerrarPol, onLeer: leerPol, onAceptar: aceptarPol)

      when auth.authError.length > 0 { Text "{auth.authError}" class("gerror") }

      Stack class("gsignup") {
        Text "¿Tienes un negocio de cuidado de perros?" class("muted t-sm")
        Link "Regístralo" -> "/signup" class("glink t-sm")
      }
    }

    Stack class("gbar") {
      Button -> submit class("gbar-cta") disabled when not valido {
        Span "Unirme"
        Icon "lucide:arrow-right"
      }
    }

    Custom SupaAuthForm inputs(mode: "join", email: @email, pw: @pw, nombre: @nombre, codigo: @codigo, politica: @politicaAceptada, nonce: @nonce) on(failed: auth.setError, session: auth.setSession)
  }
}
