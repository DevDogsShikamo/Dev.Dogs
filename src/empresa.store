# Estado del portal EMPRESA — agrega sobre muchos paseadores y clientes del negocio.
# Datos in: bridge EmpresaBridge (profiles por rol + prestaciones de hoy agregadas).
entity PaseadorRow {
  id        text
  nombre    text
  telefono  text
  salario   number
  verificado bool
  paseosHoy number
}
entity ClienteRow {
  id       text
  nombre   text
  telefono text
}
# Empleado de gestión (rol empresa, no dueño) — la "oficina".
entity GestionRow {
  id       text
  nombre   text
  telefono text
  finanzas bool
}
# Dueños (principal y co) de cada perro del negocio. Solo el jefe los lee (RLS); no se persiste.
entity Dueno {
  id      text
  perroId text
  nombre  text
  rol     text
}
# Invitación pendiente: nunca lleva el código (el servidor solo guarda su hash).
entity Invitacion {
  id     text
  rol    text
  email  text
  estado text
  vence  text
}
# Código recién creado: se muestra UNA vez y no se persiste.
entity CodigoNuevo { codigo text  email text }
# Reportes / cobros (agregados sobre prestaciones del negocio).
entity IngresoDia   { dia text  monto number }
entity TopServicio  { servicio text  monto number }
entity PaseadorIng  { id text  nombre text  monto number  paseos number }
# Salida (grupo) con su paseador asignado (para el ABM de asignación de la empresa).
entity Salida { id text  nombre text  zona text  hora text  horaNum number  duracion number  color text  servicioId text  servicio text  cuidadorId text  cuidadorNombre text }
# Pendiente de cobro: un paseo realizado, cobrable y aún no cobrado.
entity Pendiente { id text  fecha text  perro text  servicio text  monto number }
# Agenda semanal (multi-paseador): cabeceras de día + salidas por (día, hora, servicio, paseador).
entity AgendaDia  { fecha text  label text  count number }
entity AgendaItem { fecha text  hora text  tipo text  servicio text  cuidador text  dogs number  cancelados number  estado text  color text  recibido text  entrega text }
# A dog of an outing (active membership) and its weekdays: d1..d7 = Monday..Sunday, dias = their label. Same shape
# as grupos.Miembro; kept here because grupos.store persists state and this portal keeps nothing on the device (P8).
entity SalidaPerro { id text  grupoId text  perroId text  nombre text  dias text  d1 bool  d2 bool  d3 bool  d4 bool  d5 bool  d6 bool  d7 bool }
# A booking nobody is assigned to yet (a service without an outing).
entity ServicioSinAsignar { id text  fecha text  hora text  servicio text  perro text }
# Reseña de un cliente (solo el jefe la lee y la modera; RLS).
entity ResenaNeg { id text  autor text  rating number  texto text  publicar bool  estado text  fecha text }

state {
  # Sin persist (data-protection P8): el portal empresa no guarda nada en el dispositivo ni abre offline.
  paseadores  = [] : list<PaseadorRow>
  clientes    = [] : list<ClienteRow>
  gestion     = [] : list<GestionRow>
  # Métricas de hoy (todos los paseadores del negocio).
  paseosHoy   = 0 : number
  programados = 0 : number
  enCurso     = 0 : number
  finalizados = 0 : number
  perrosTot   = 0 : number
  invitaciones = [] : list<Invitacion>
  codigoNuevo  = "" : text
  codigoEmail  = "" : text
  duenos      = [] : list<Dueno>
  # Finanzas de los últimos 30 días (the month summary lives in the Reportes page).
  ingresosDia  = [] : list<IngresoDia>
  topServicios = [] : list<TopServicio>
  porPaseador  = [] : list<PaseadorIng>
  salidas      = [] : list<Salida>
  pendientes   = [] : list<Pendiente>
  agendaDias   = [] : list<AgendaDia>
  agenda       = [] : list<AgendaItem>
  resenas      = [] : list<ResenaNeg>
  miembros     = [] : list<SalidaPerro>
  sinAsignar   = [] : list<ServicioSinAsignar>
  loaded       = false : bool
}
action setMiembros(rows: list<SalidaPerro>) mutates miembros { miembros.set(rows) }
action setSinAsignar(rows: list<ServicioSinAsignar>) mutates sinAsignar { sinAsignar.set(rows) }
# Optimistic: a removed dog and an assigned booking leave their lists at once (the RPC's refresh reconciles).
action miembroDel(key: text) mutates miembros { miembros.remove where id == key }
action sinAsignarDel(sid: text) mutates sinAsignar { sinAsignar.remove where id == sid }
get nResenas = resenas.length
action setResenas(rows: list<ResenaNeg>) mutates resenas { resenas.set(rows) }
action resenaSet(rid: text, est: text) mutates resenas { resenas.patch where id == rid with { estado: est } }

get pendienteTotal = pendientes.sum by monto
get nPendientes    = pendientes.length
get nAgenda        = agenda.length

get nPaseadores = paseadores.length
get nClientes   = clientes.length
get nGestion    = gestion.length

action setPaseadores(rows: list<PaseadorRow>) mutates paseadores { paseadores.set(rows) }
action setClientes(rows: list<ClienteRow>) mutates clientes { clientes.set(rows) }
action setGestion(rows: list<GestionRow>) mutates gestion { gestion.set(rows) }
action setPerrosTot(n: number) mutates perrosTot { perrosTot.set(n) }
action setInvitaciones(rows: list<Invitacion>) mutates invitaciones { invitaciones.set(rows) }
action setCodigoNuevo(c: CodigoNuevo) mutates codigoNuevo, codigoEmail { codigoNuevo.set(c.codigo)  codigoEmail.set(c.email) }
action codigoCerrar mutates codigoNuevo, codigoEmail { codigoNuevo.set("")  codigoEmail.set("") }
action setDuenos(rows: list<Dueno>) mutates duenos { duenos.set(rows) }
# Optimista: el permiso de finanzas cambia al instante (el RPC lo confirma).
action finanzasSet(pid: text, on: bool) mutates gestion { gestion.patch where id == pid with { finanzas: on } }
# Optimistas: el salario cambia al instante; la invitación desaparece al quitarla.
action salarioSet(pid: text, sal: number) mutates paseadores { paseadores.patch where id == pid with { salario: sal } }
action invitaDel(pid: text) mutates invitaciones { invitaciones.remove where id == pid }
# Reportes / cobros
action setIngresosDia(rows: list<IngresoDia>) mutates ingresosDia { ingresosDia.set(rows) }
action setTopServicios(rows: list<TopServicio>) mutates topServicios { topServicios.set(rows) }
action setPorPaseador(rows: list<PaseadorIng>) mutates porPaseador { porPaseador.set(rows) }
action setSalidas(rows: list<Salida>) mutates salidas { salidas.set(rows) }
# Optimista: borrar una salida desaparece al instante (grupoEliminar no refresca).
action salidaDel(sid: text) mutates salidas { salidas.remove where id == sid }
action setPendientes(rows: list<Pendiente>) mutates pendientes { pendientes.set(rows) }
action setAgendaDias(rows: list<AgendaDia>) mutates agendaDias { agendaDias.set(rows) }
action setAgenda(rows: list<AgendaItem>) mutates agenda { agenda.set(rows) }
# Optimista: marcar cobrado saca el pendiente de la lista al instante.
action cobroDel(pid: text) mutates pendientes { pendientes.remove where id == pid }
# Optimista: reasignar paseador a una salida se refleja al instante.
action asignarSet(sid: text, cid: text, cnom: text) mutates salidas { salidas.patch where id == sid with { cuidadorId: cid, cuidadorNombre: cnom } }
action setLoaded mutates loaded { loaded.set(true) }
action setStats(hoy: number, prog: number, curso: number, fin: number) mutates paseosHoy, programados, enCurso, finalizados {
  paseosHoy.set(hoy)  programados.set(prog)  enCurso.set(curso)  finalizados.set(fin)
}
# Limpia los datos del negocio al hacer logout (dispositivo compartido).
action limpiar mutates paseadores, clientes, gestion, invitaciones, codigoNuevo, codigoEmail, duenos, salidas, pendientes, agendaDias, agenda, ingresosDia, topServicios, porPaseador, paseosHoy, programados, enCurso, finalizados, perrosTot, resenas, miembros, sinAsignar, loaded {
  miembros.reset()  sinAsignar.reset()  resenas.reset()  paseadores.reset()  clientes.reset()  gestion.reset()  invitaciones.reset()  codigoNuevo.set("")  codigoEmail.set("")  duenos.reset()  salidas.reset()  pendientes.reset()  agendaDias.reset()  agenda.reset()  ingresosDia.reset()  topServicios.reset()  porPaseador.reset()
  paseosHoy.set(0)  programados.set(0)  enCurso.set(0)  finalizados.set(0)  perrosTot.set(0)  loaded.set(false)
}
