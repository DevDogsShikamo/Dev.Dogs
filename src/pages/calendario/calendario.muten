screen calendario
use cop from "~/lib/money.ts"

Page class("screen gap-lg") {
  Stack class("gap-xs") {
    Text "Agenda" class("t-xl black")
    Text "Martes, 28 de agosto" class("muted")
  }

  Stack class("grid grid-3") {
    Stack class("panel pad-md gap-xs") { Span "Cobrado" class("kpi-l")  Text "{cop(agenda.cobrado)}" class("bold t-lg") }
    Stack class("panel pad-md gap-xs") { Span "Por cobrar" class("kpi-l")  Text "{cop(agenda.porCobrar)}" class("bold t-lg coral") }
    Stack class("panel pad-md gap-xs") { Span "Paseos" class("kpi-l")  Text "{agenda.hechos}/{agenda.total}" class("bold t-lg") }
  }

  List class("gap-md") {
    each agenda.citas as c {
      Stack class("cal-row") {
        Span "{c.hora}" class("cal-time")
        Stack class("appt") class("{c.svcClass}") {
          Stack class("gap-xs") {
            Text "{c.perro} · {c.servicio}" class("bold")
            Text "{c.cliente} · {c.direccion}" class("sub")
          }
          Stack class("row center gap-sm") {
            Text "{cop(c.precio)}" class("bold")
            when not c.pagado { Button "Cobrar" -> agenda.marcarPagado(c.id) class("chip") }
            when c.pagado { Span "Pagado" class("badge badge-paid") }
            when not c.hecho { Button -> agenda.marcarHecho(c.id) class("iconbtn") aria(label: "Marcar hecho") { Icon "lucide:check" } }
            when c.hecho { Icon "lucide:check-circle-2" }
          }
        }
      }
    }
  }
}
