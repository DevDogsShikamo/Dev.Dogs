screen empresa
use cop from "~/lib/money.ts"
use paseadorSalario, invitarCrear, invitacionQuitar, grupoAsignar, cobroMarcar, servicioCrear, servicioActualizar, servicioEliminar from "~/lib/data.ts"
use copiarCodigo, copiarLink from "~/lib/share.ts"
use tipoLabel from "~/lib/svc.ts"

# Draft del servicio (alta/edición) — el Form de Muten necesita page-state.
entity ServicioDraft {
  nombre   text required
  tipo     paseo | guarderia | bano | corte | adiestramiento | veterinaria | comida | accesorio
  duracion number
  precio   number
  modelo   por_uso | mensual
}

# Portal EMPRESA — panel a nivel negocio: agrega sobre muchos paseadores y clientes.
# Reutiliza la estética .dd-* del panel del paseador. Datos: EmpresaBridge (una vez
# en el root) + store `empresa`. Fase 2: gestión (salario + invitaciones).

state {
  section = "dashboard" : text
  salEdit   = "" : text
  salNombre = "" : text
  salVal    = 0  : number
  salForm   = false : bool
  invRol    = "paseador" : text
  invEmail  = "" : text
  invForm   = false : bool
  asigSalida = "" : text
  asigNombre = "" : text
  asigForm   = false : bool
  sdraft   = {} : ServicioDraft
  sedit    = "" : text
  sform    = false : bool
}
action go(s: text) mutates section { section.set(s) }

# ---- Catálogo de servicios (ABM del jefe) ----
action servicioNuevo mutates sdraft, sedit, sform { sdraft.reset()  sedit.set("")  sform.set(true) }
action servicioEditar(id: text, nombre: text, tipo: text, duracion: number, precio: number, modelo: text) mutates sdraft, sedit, sform {
  sdraft.set({ nombre: nombre, tipo: tipo, duracion: duracion, precio: precio, modelo: modelo })
  sedit.set(id)  sform.set(true)
}
action servicioCerrar mutates sform { sform.set(false) }
action servicioGuardar(s: ServicioDraft) mutates sform {
  if sedit == "" { servicioCrear(s) }
  else { servicios.servicioUpd(sedit, s.nombre, s.tipo, s.duracion, s.precio, s.modelo)  servicioActualizar(sedit, s) }
  sform.set(false)
}
action servicioBorrar(id: text) { servicios.servicioDel(id)  servicioEliminar(id) }

# ---- Editar salario del paseador (optimista) ----
action salAbrir(id: text, nombre: text, sal: number) mutates salEdit, salNombre, salVal, salForm { salEdit.set(id)  salNombre.set(nombre)  salVal.set(sal)  salForm.set(true) }
action salCerrar mutates salForm { salForm.set(false) }
action salGuardar mutates salForm { empresa.salarioSet(salEdit, salVal)  paseadorSalario(salEdit, salVal)  salForm.set(false) }

# ---- Invitar paseador / cliente ----
action invAbrir(rol: text) mutates invRol, invEmail, invForm { invRol.set(rol)  invEmail.set("")  invForm.set(true) }
action invCerrar mutates invForm { invForm.set(false) }
action invGuardar mutates invForm { invitarCrear(invRol, invEmail)  invForm.set(false) }
action invBorrar(id: text) { empresa.invitaDel(id)  invitacionQuitar(id) }
# Compartir invitación: copiar el código o un link con el código precargado.
action copCod(c: text) { copiarCodigo(c) }
action copLink(c: text) { copiarLink(c) }

# ---- Asignar paseador a una salida (optimista) ----
action asigAbrir(id: text, nombre: text) mutates asigSalida, asigNombre, asigForm { asigSalida.set(id)  asigNombre.set(nombre)  asigForm.set(true) }
action asigCerrar mutates asigForm { asigForm.set(false) }
action asigElegir(cid: text, cnom: text) mutates asigForm { empresa.asignarSet(asigSalida, cid, cnom)  grupoAsignar(asigSalida, cid)  asigForm.set(false) }

# ---- Cobrar un paseo pendiente (optimista + persiste) ----
action cobrar(id: text) { empresa.cobroDel(id)  cobroMarcar(id, auth.userId) }

Stack class("dd-app") {

  # Puente de datos del negocio (montado una vez).
  Custom EmpresaBridge on(paseadores: empresa.setPaseadores, clientes: empresa.setClientes, gestion: empresa.setGestion, perrosTot: empresa.setPerrosTot, stats: empresa.setStats, invitaciones: empresa.setInvitaciones, servicios: servicios.setServicios)
  Custom ReportesBridge on(finanzas: empresa.setFinanzas, ingresosDia: empresa.setIngresosDia, topServicios: empresa.setTopServicios, porPaseador: empresa.setPorPaseador, pendientes: empresa.setPendientes)
  Custom SalidasBridge on(salidas: empresa.setSalidas)

  # ---------- SIDEBAR (escritorio) ----------
  Sidebar class("dd-side") {
    Stack class("dd-brand") { Span "D" class("dd-logo")  Span "DevDogs" class("dd-brandname") }
    Span "Empresa" class("dd-navlbl")
    Button -> go("dashboard")  class("dd-lnk") class("dd-on" when section == "dashboard")  { Icon "lucide:home"        Span "Inicio" }
    Button -> go("paseadores") class("dd-lnk") class("dd-on" when section == "paseadores") { Icon "lucide:users"       Span "Paseadores" }
    when auth.isOwner {
      Button -> go("clientes") class("dd-lnk") class("dd-on" when section == "clientes") { Icon "lucide:user-round"  Span "Clientes" }
    }
    Button -> go("salidas")    class("dd-lnk") class("dd-on" when section == "salidas")    { Icon "lucide:map-pin"     Span "Salidas" }
    when auth.isOwner {
      Button -> go("servicios") class("dd-lnk") class("dd-on" when section == "servicios") { Icon "lucide:tag" Span "Servicios" }
    }
    when auth.isOwner {
      Button -> go("reportes") class("dd-lnk") class("dd-on" when section == "reportes") { Icon "lucide:bar-chart-3" Span "Reportes" }
    }
    Button -> go("perfil")     class("dd-lnk") class("dd-on" when section == "perfil")     { Icon "lucide:user"        Span "Perfil" }
    Stack class("dd-foot") {
      Span "{initial(auth.userName)}" class("dd-ua")
      Stack { Span "{auth.userName}" class("dd-un")  when auth.isOwner { Span "Dueño" class("dd-ur") }  when auth.isGestion { Span "Gestión" class("dd-ur") } }
    }
  }

  # ---------- CONTENIDO ----------
  Stack class("dd-content") {
    Stack class("dd-screen") {

      # ==== INICIO (métricas del negocio) ====
      when section == "dashboard" {
        Stack class("dd-sec") {
          Stack class("dd-top") {
            Stack class("dd-greet") {
              Span "{initial(auth.userName)}" class("dd-ga")
              Stack { Span "Buen día 👋" class("dd-gm")  Span "{auth.userName}" class("dd-gn") }
            }
          }

          Stack class("dd-h1") aria(role: "heading", level: "1") {
            Span "{empresa.paseosHoy} paseos"
            Span "hoy en el negocio"
          }

          Stack class("dd-emp-kpis") {
            Button -> go("paseadores") class("dd-emp-kpi") { Icon "lucide:users"       Span "{empresa.nPaseadores}" class("v")  Span "Paseadores" class("l") }
            when auth.isOwner {
              Button -> go("clientes") class("dd-emp-kpi") { Icon "lucide:user-round"  Span "{empresa.nClientes}" class("v")    Span "Clientes" class("l") }
            }
            when auth.isOwner {
              Stack class("dd-emp-kpi")                     { Icon "lucide:dog"         Span "{empresa.perrosTot}" class("v")    Span "Perros" class("l") }
            }
          }

          Span "Paseos de hoy" class("dd-emp-lbl")
          Stack class("dd-emp-estados") {
            Stack class("dd-emp-est e-prog")  { Span "{empresa.programados}" class("v")  Span "Programados" class("l") }
            Stack class("dd-emp-est e-curso") { Span "{empresa.enCurso}" class("v")      Span "En curso" class("l") }
            Stack class("dd-emp-est e-fin")   { Span "{empresa.finalizados}" class("v")  Span "Finalizados" class("l") }
          }
        }
      }

      # ==== PASEADORES ====
      when section == "paseadores" {
        Stack class("dd-sec") {
          Stack class("dd-cat-head") {
            Title "Paseadores" h2
            when auth.isOwner {
              Button -> invAbrir("paseador") class("dd-cat-add") { Icon "lucide:user-plus"  Span "Invitar" }
            }
          }
          # Invitaciones pendientes (paseador) — solo el jefe las gestiona.
          when auth.isOwner {
            each empresa.invitaciones as iv where iv.rol == "paseador" {
              InviteItem(iv: iv, onCopyCode: copCod, onCopyLink: copLink, onDelete: invBorrar)
            }
          }
          when empresa.nPaseadores == 0 {
            Stack class("dd-ph") { Stack class("dd-pi") { Icon "lucide:users" }  Title "Sin paseadores" h2  Text "Invitá a tu primer paseador con el botón de arriba." }
          }
          Stack class("dd-cat-list") {
            each empresa.paseadores as p {
              Stack class("dd-cat-item") {
                Stack class("av") { Span "{initial(p.nombre)}" }
                Stack class("dd-cat-info") {
                  Stack class("nmline") {
                    Span "{p.nombre}" class("nm")
                    when p.verificado { Span "✓" class("dd-emp-ver") }
                    when p.zona { Span "{p.zona}" class("cd") }
                  }
                  when auth.isOwner { Span "{p.paseosHoy} paseos hoy · {cop(p.salario)}/mes" class("meta") }
                  when auth.isGestion { Span "{p.paseosHoy} paseos hoy" class("meta") }
                  when p.telefono { Span "{p.telefono}" class("obs") }
                }
                when auth.isOwner {
                  Stack class("acts") {
                    Button -> salAbrir(p.id, p.nombre, p.salario) class("dd-cat-icon") aria(label: "Editar salario de {p.nombre}") { Icon "lucide:pencil" }
                  }
                }
              }
            }
          }
        }
      }

      # ==== CLIENTES ====
      when section == "clientes" {
        Stack class("dd-sec") {
          Stack class("dd-cat-head") {
            Title "Clientes" h2
            Button -> invAbrir("cliente") class("dd-cat-add") { Icon "lucide:user-plus"  Span "Invitar" }
          }
          each empresa.invitaciones as iv where iv.rol == "cliente" {
            InviteItem(iv: iv, onCopyCode: copCod, onCopyLink: copLink, onDelete: invBorrar)
          }
          when empresa.nClientes == 0 {
            Stack class("dd-ph") { Stack class("dd-pi") { Icon "lucide:user-round" }  Title "Sin clientes" h2  Text "Invitá a tu primer cliente con el botón de arriba." }
          }
          Stack class("dd-cat-list") {
            each empresa.clientes as c {
              Stack class("dd-cat-item") {
                Stack class("av") { Span "{initial(c.nombre)}" }
                Stack class("dd-cat-info") {
                  Stack class("nmline") { Span "{c.nombre}" class("nm") }
                  when c.telefono { Span "{c.telefono}" class("meta") }
                }
              }
            }
          }
        }
      }

      # ==== SALIDAS (asignar paseador) ====
      when section == "salidas" {
        Stack class("dd-sec") {
          Stack class("dd-cat-head") { Title "Salidas" h2 }
          when empresa.salidas.length == 0 {
            Stack class("dd-ph") { Stack class("dd-pi") { Icon "lucide:map-pin" }  Title "Sin salidas" h2  Text "No hay salidas configuradas en el negocio." }
          }
          Stack class("dd-cat-list") {
            each empresa.salidas as s {
              Stack class("dd-cat-item") {
                Stack class("dd-sv-ic") { Icon "lucide:map-pin" }
                Stack class("dd-cat-info") {
                  Stack class("nmline") { Span "{s.nombre}" class("nm")  when s.zona { Span "{s.zona}" class("cd") } }
                  Span "{s.hora} · {s.servicio}" class("meta")
                  when s.cuidadorNombre { Span "Paseador: {s.cuidadorNombre}" class("obs") }
                  when s.cuidadorNombre == "" { Span "Sin asignar" class("dd-sal-sin") }
                }
                Stack class("acts") {
                  Button -> asigAbrir(s.id, s.nombre) class("dd-cat-icon") aria(label: "Asignar paseador a {s.nombre}") { Icon "lucide:user-cog" }
                }
              }
            }
          }
        }
      }

      # ==== REPORTES / COBROS ====
      when section == "reportes" {
        Stack class("dd-sec") {
          Stack class("dd-cat-head") { Title "Reportes" h2 }
          Stack class("dd-emp-kpis") {
            Stack class("dd-emp-kpi dd-rep-kpi") { Icon "lucide:wallet"        Span "{cop(empresa.facturado)}" class("v")  Span "Facturado (30d)" class("l") }
            Stack class("dd-emp-kpi dd-rep-kpi") { Icon "lucide:circle-check"  Span "{cop(empresa.cobrado)}" class("v")    Span "Cobrado" class("l") }
            Stack class("dd-emp-kpi dd-rep-kpi") { Icon "lucide:clock"         Span "{cop(empresa.pendiente)}" class("v")  Span "Pendiente" class("l") }
          }
          # Pendientes de cobro (paseos realizados sin cobrar) — el jefe marca cobrado.
          Span "Pendientes de cobro · {cop(empresa.pendienteTotal)}" class("dd-emp-lbl")
          when empresa.nPendientes == 0 { Text "Todo al día — nada por cobrar." class("dd-cli-empty") }
          Stack class("dd-cat-list") {
            each empresa.pendientes as pe {
              Stack class("dd-cat-item") {
                Stack class("dd-sv-ic") { Icon "lucide:wallet" }
                Stack class("dd-cat-info") {
                  Stack class("nmline") { Span "{pe.perro}" class("nm")  Span "{pe.servicio}" class("cd") }
                  Span "{pe.fecha} · {cop(pe.monto)}" class("meta")
                }
                Stack class("acts") {
                  Button "Cobrado" -> cobrar(pe.id) class("dd-cat-add dd-cobrar-btn")
                }
              }
            }
          }

          Stack class("dd-rep-card") { Chart @empresa.ingresosDia "Ingresos por día (7d)" kind(bar) x(dia) y(monto) }
          Stack class("dd-rep-card") { Chart @empresa.topServicios "Top servicios (30d)" kind(donut) x(servicio) y(monto) }
          Span "Por paseador (30d)" class("dd-emp-lbl")
          Stack class("dd-cat-list") {
            each empresa.porPaseador as pp {
              Stack class("dd-cat-item") {
                Stack class("av") { Span "{initial(pp.nombre)}" }
                Stack class("dd-cat-info") {
                  Stack class("nmline") { Span "{pp.nombre}" class("nm") }
                  Span "{pp.paseos} paseos" class("meta")
                }
                Span "{cop(pp.monto)}" class("dd-rep-monto")
              }
            }
          }
        }
      }

      # ==== SERVICIOS (catálogo del negocio — ABM del jefe) ====
      when section == "servicios" {
        Stack class("dd-sec") {
          Stack class("dd-cat-head") {
            Title "Servicios" h2
            Button -> servicioNuevo class("dd-cat-add") { Icon "lucide:plus"  Span "Agregar" }
          }
          when servicios.total == 0 {
            Stack class("dd-ph") { Stack class("dd-pi") { Icon "lucide:tag" }  Title "Sin servicios" h2  Text "Creá tu oferta: paseo, guardería, baño, corte de garras…" }
          }
          Stack class("dd-cat-list") {
            each servicios.servicios as s {
              Stack class("dd-cat-item") {
                Stack class("dd-sv-ic") { Icon "lucide:tag" }
                Stack class("dd-cat-info") {
                  Stack class("nmline") { Span "{s.nombre}" class("nm")  Span "{tipoLabel(s.tipo)}" class("cd") }
                  Span "{s.duracion} min" class("meta")
                }
                Stack class("dd-sv-price") {
                  Span "{cop(s.precio)}" class("amt")
                  when s.modelo == "mensual" { Span "/mes" class("per") }
                }
                Stack class("acts") {
                  Button -> servicioEditar(s.id, s.nombre, s.tipo, s.duracion, s.precio, s.modelo) class("dd-cat-icon") aria(label: "Editar servicio") { Icon "lucide:pencil" }
                  Button -> servicioBorrar(s.id) class("dd-cat-icon dd-danger") aria(label: "Eliminar servicio") { Icon "lucide:trash-2" }
                }
              }
            }
          }
          when sform {
            Stack class("dd-cal-scrim") {
              Stack class("dd-cal-scrimbg") on(click: servicioCerrar)
              Stack class("dd-cal-sheet") aria(role: "dialog", modal: true) {
                Stack class("dd-cat-formhead") {
                  Title "Datos del servicio" h3
                  Button -> servicioCerrar class("dd-cal-sheet-x") aria(label: "Cerrar") { Icon "lucide:x" }
                }
                Form bind(sdraft) submit(servicioGuardar) "Guardar servicio"
              }
            }
          }
        }
      }

      # ==== PERFIL ====
      when section == "perfil" {
        Stack class("dd-sec") {
          Stack class("dd-pf-hero") {
            Span "{initial(auth.userName)}" class("dd-pf-av")
            Span "{auth.userName}" class("dd-pf-name")
            when auth.isOwner { Span "Dueño" class("dd-pf-role") }
            when auth.isGestion { Span "Gestión" class("dd-pf-role") }
          }
          Stack class("dd-pf-stats") {
            Stack class("dd-pf-stat") { Span "{empresa.nPaseadores}" class("v")  Span "Paseadores" class("l") }
            when auth.isOwner { Stack class("dd-pf-stat") { Span "{empresa.nClientes}" class("v")  Span "Clientes" class("l") } }
            when auth.isOwner { Stack class("dd-pf-stat") { Span "{empresa.perrosTot}" class("v")  Span "Perros" class("l") } }
          }

          # ---- Equipo de gestión (la oficina) — solo el jefe invita y ve ----
          when auth.isOwner {
            Stack class("dd-pf-team") {
              Stack class("dd-cat-head") {
                Title "Equipo de gestión" h2
                Button -> invAbrir("empresa") class("dd-cat-add") { Icon "lucide:user-plus"  Span "Invitar" }
              }
              # Invitaciones de gestión pendientes.
              each empresa.invitaciones as iv where iv.rol == "empresa" {
                InviteItem(iv: iv, onCopyCode: copCod, onCopyLink: copLink, onDelete: invBorrar)
              }
              when empresa.nGestion == 0 {
                Text "Aún no hay empleados de gestión. Invitá a alguien para compartir la oficina." class("dd-rel-hint")
              }
              Stack class("dd-cat-list") {
                each empresa.gestion as g {
                  Stack class("dd-cat-item") {
                    Stack class("av") { Span "{initial(g.nombre)}" }
                    Stack class("dd-cat-info") {
                      Stack class("nmline") { Span "{g.nombre}" class("nm") }
                      when g.telefono { Span "{g.telefono}" class("meta") }
                    }
                  }
                }
              }
            }
          }

          Button -> auth.logout class("dd-pf-logout") { Icon "lucide:log-out"  Span "Cerrar sesión" }
        }
      }

      # ---- Modal: editar salario ----
      when salForm {
        Stack class("dd-cal-scrim") {
          Stack class("dd-cal-scrimbg") on(click: salCerrar)
          Stack class("dd-cal-sheet") aria(role: "dialog", modal: true) {
            Stack class("dd-cat-formhead") {
              Title "Salario de {salNombre}" h3
              Button -> salCerrar class("dd-cal-sheet-x") aria(label: "Cerrar") { Icon "lucide:x" }
            }
            Stack class("dd-gform") {
              Span "Salario mensual (COP)" class("dd-hor-lbl")
              Number bind(salVal) min(0) max(100000000)
              Button "Guardar" -> salGuardar class("dd-cat-add dd-hor-save")
            }
          }
        }
      }

      # ---- Modal: invitar paseador / cliente ----
      when invForm {
        Stack class("dd-cal-scrim") {
          Stack class("dd-cal-scrimbg") on(click: invCerrar)
          Stack class("dd-cal-sheet") aria(role: "dialog", modal: true) {
            Stack class("dd-cat-formhead") {
              when invRol == "empresa" { Title "Invitar a gestión" h3 }
              when invRol == "paseador" { Title "Invitar paseador" h3 }
              when invRol == "cliente" { Title "Invitar cliente" h3 }
              Button -> invCerrar class("dd-cal-sheet-x") aria(label: "Cerrar") { Icon "lucide:x" }
            }
            Stack class("dd-gform") {
              Span "Email (opcional)" class("dd-hor-lbl")
              SearchField bind(invEmail) "correo@ejemplo.com"
              Text "Se genera un código único para que se una al negocio." class("dd-rel-hint")
              Button "Crear invitación" -> invGuardar class("dd-cat-add dd-hor-save")
            }
          }
        }
      }

      # ---- Modal: asignar paseador a una salida ----
      when asigForm {
        Stack class("dd-cal-scrim") {
          Stack class("dd-cal-scrimbg") on(click: asigCerrar)
          Stack class("dd-cal-sheet") aria(role: "dialog", modal: true) {
            Stack class("dd-cat-formhead") {
              Title "Asignar a {asigNombre}" h3
              Button -> asigCerrar class("dd-cal-sheet-x") aria(label: "Cerrar") { Icon "lucide:x" }
            }
            Stack class("dd-gform") {
              Span "Elegí un paseador" class("dd-hor-lbl")
              Stack class("dd-gsvc") {
                Button "Sin asignar" -> asigElegir("", "") class("dd-gchip")
                each empresa.paseadores as p {
                  Button "{p.nombre}" -> asigElegir(p.id, p.nombre) class("dd-gchip")
                }
              }
            }
          }
        }
      }
    }
  }

  # ---------- BOTTOM NAV (móvil) ----------
  Nav class("dd-tabbar") {
    Button -> go("dashboard")  class("dd-on" when section == "dashboard")  aria(label: "Inicio") { Icon "lucide:home" }
    Button -> go("paseadores") class("dd-on" when section == "paseadores") aria(label: "Paseadores") { Icon "lucide:users" }
    when auth.isOwner {
      Button -> go("clientes") class("dd-on" when section == "clientes")   aria(label: "Clientes") { Icon "lucide:user-round" }
    }
    Button -> go("salidas")    class("dd-on" when section == "salidas")    aria(label: "Salidas") { Icon "lucide:map-pin" }
    when auth.isOwner {
      Button -> go("servicios") class("dd-on" when section == "servicios") aria(label: "Servicios") { Icon "lucide:tag" }
    }
    when auth.isOwner {
      Button -> go("reportes") class("dd-on" when section == "reportes")   aria(label: "Reportes") { Icon "lucide:bar-chart-3" }
    }
    Button -> go("perfil")     class("dd-on" when section == "perfil")     aria(label: "Perfil") { Icon "lucide:user" }
  }
}
