screen cliente
use reservarPaseo, reservarServicio, venderProducto, crearMiPerro, resenaGuardar, reservaCancelar, fotoReportar, miembroSalir from "~/lib/data.ts"
use descargarEstadoCuentaCSV, descargarEstadoCuentaExcel from "~/lib/export.ts"
use cop from "~/lib/money.ts"
use tipoLabel from "~/lib/svc.ts"
use estadoCertificado from "~/lib/kiara.js"

# Alta de perro propio del cliente (queda como dueño principal vía RPC crear_mi_perro).
entity PerroDraft {
  nombre       text required
  raza         text
  tamano       pequeno | mediano | grande
  conducta     tranquilo | energico | reactivo | sociable | jalador
  sociabilidad excelente | bueno | cuidado | selectivo
  tips         text
}
# Policies of the business (PoliticaBridge): the published sections and {version, fecha}; read-only here
# (the client accepts each version at /aceptar-condiciones).
entity PolSec { clave text  titulo text  texto text }
entity PolMeta { version text  fecha text }

# Portal CLIENTE (dueño del perro). Reutiliza la estética .dd-* del paseador.
# Datos: ClienteBridge (root) + store `cliente`. Inicio · Mis perros · Reservar
# (acoplarse a las salidas de zona) · Agenda de paseos · Perfil.

state {
  section = "dashboard" : text
  # Reservar: the outings of the business (salidas) or its other services (bath, daycare...).
  resTab  = "salidas" : text
  salirNeg = false : bool
  resSalidaId = "" : text
  resSvcId    = "" : text
  resHora     = "" : text
  resZona     = "" : text
  resPerro    = "" : text
  resFecha    = "" : text
  resForm     = false : bool
  svcId       = "" : text
  svcNombre   = "" : text
  svcPerro    = "" : text
  svcFecha    = "" : text
  svcForm     = false : bool
  prodId       = "" : text
  prodNombre   = "" : text
  prodPerro    = "" : text
  prodCantidad = 1  : number
  prodForm     = false : bool
  pdraft       = {} : PerroDraft
  pform        = false : bool
  notifOpen    = false : bool
  rsRating     = 0 : number
  rsTexto      = "" : text
  rsPublicar   = false : bool
  rsForm       = false : bool
  secs         = [] : list<PolSec>
  polVer       = "" : text
  polFecha     = "" : text
  polForm      = false : bool
  # The scheduled service the client is about to cancel (in-page confirmation step).
  cancelId     = "" : text
  # Photo with its "Reportar" reasons open (Ley 1581 art. 7: a person or a minor appears in it).
  repFoto      = "" : text
}
# Cancel a scheduled service of my dog: ask first, then the RPC (any fee is the business's own policy).
action cancelPedir(id: text) mutates cancelId { cancelId.set(id) }
action cancelNo mutates cancelId { cancelId.set("") }
action cancelConfirmar mutates cancelId { reservaCancelar(cancelId)  cancelId.set("") }
action repAbrir(id: text) mutates repFoto { repFoto.set(id) }
action repCerrar mutates repFoto { repFoto.set("") }
action repEnviar(motivo: text) mutates repFoto { fotoReportar(repFoto, motivo)  repFoto.set("") }
# The bell: incidents of my dogs (a loss or a death always, the others for 7 days) and then the walk news.
get nAvisos = cliente.nNovedades + incidentes.avisos
# Reseña del negocio: nueva (vacía, casilla del nombre sin marcar) o editar la mía.
action rsNueva mutates rsRating, rsTexto, rsPublicar, rsForm { rsRating.set(0)  rsTexto.set("")  rsPublicar.set(false)  rsForm.set(true) }
action rsEditar(rating: number, texto: text, publicar: bool) mutates rsRating, rsTexto, rsPublicar, rsForm { rsRating.set(rating)  rsTexto.set(texto)  rsPublicar.set(publicar)  rsForm.set(true) }
action rsPick(n: number) mutates rsRating { rsRating.set(n) }
action rsCerrar mutates rsForm { rsForm.set(false) }
action rsEnviar mutates rsForm { resenaGuardar(rsRating, rsTexto, rsPublicar)  rsForm.set(false) }
# The business that provides the service (auth.negocioNombre, reported at login); a session stored before
# the name was reported shows a generic label until the next login.
get prestador = auth.negocioNombre != "" ? auth.negocioNombre : "tu negocio"
action go(s: text) mutates section { section.set(s) }
action resTabSet(t: text) mutates resTab { resTab.set(t) }
action polSecs(rows: list<PolSec>) mutates secs { secs.set(rows) }
action polMeta(rows: list<PolMeta>) mutates polVer, polFecha {
  if rows.length > 0 { polVer.set(rows.at(0).version)  polFecha.set(rows.at(0).fecha) }
}
get polTitulo = "Políticas de " + prestador
action polAbrir mutates polForm { polForm.set(true) }
action polCerrar mutates polForm { polForm.set(false) }
action notifToggle mutates notifOpen { notifOpen.toggle() }
action notifCerrar mutates notifOpen { notifOpen.set(false) }
action irAgenda mutates section, notifOpen { section.set("agenda")  notifOpen.set(false) }
# Registrar un perro propio (el server lo crea y me enlaza como dueño principal).
action perroNuevo mutates pdraft, pform { pdraft.reset()  pform.set(true) }
action perroCerrar mutates pform { pform.set(false) }
action miPerroGuardar(p: PerroDraft) mutates pform { crearMiPerro(p)  pform.set(false) }
# Logout: limpia el cache del cliente (dispositivo compartido) y cierra sesión.
action salir { cliente.limpiar()  incidentes.limpiar()  auth.logout() }
# Leave the business (confirmed in the page): the client loses its access and its links to the dogs; the session ends.
action salirNegPedir mutates salirNeg { salirNeg.set(true) }
action salirNegNo mutates salirNeg { salirNeg.set(false) }
action salirNegSi mutates salirNeg { miembroSalir()  salirNeg.set(false) }
action resAbrir(sid: text, svc: text, hora: text, zona: text) mutates resSalidaId, resSvcId, resHora, resZona, resPerro, resFecha, resForm {
  resSalidaId.set(sid)  resSvcId.set(svc)  resHora.set(hora)  resZona.set(zona)  resPerro.set("")  resFecha.set("")  resForm.set(true)
}
action resPickPerro(id: text) mutates resPerro { resPerro.set(id) }
action resCerrar mutates resForm { resForm.set(false) }
action resConfirmar mutates resForm { reservarPaseo(resPerro, resSvcId, resSalidaId, resFecha)  resForm.set(false) }
# Pedir un servicio (baño/guardería/corte/…): elegir perro + fecha → prestación.
action svcAbrir(id: text, nombre: text) mutates svcId, svcNombre, svcPerro, svcFecha, svcForm { svcId.set(id)  svcNombre.set(nombre)  svcPerro.set("")  svcFecha.set("")  svcForm.set(true) }
action svcPickPerro(id: text) mutates svcPerro { svcPerro.set(id) }
action svcCerrar mutates svcForm { svcForm.set(false) }
action svcConfirmar mutates svcForm { reservarServicio(svcPerro, svcId, svcFecha)  svcForm.set(false) }
# Comprar un producto (comida/snack): perro + cantidad → compra de hoy al precio del catálogo.
action prodAbrir(id: text, nombre: text) mutates prodId, prodNombre, prodPerro, prodCantidad, prodForm { prodId.set(id)  prodNombre.set(nombre)  prodPerro.set("")  prodCantidad.set(1)  prodForm.set(true) }
action prodPickPerro(id: text) mutates prodPerro { prodPerro.set(id) }
action prodCerrar mutates prodForm { prodForm.set(false) }
action prodConfirmar mutates prodForm { venderProducto(prodPerro, prodId, prodCantidad)  prodForm.set(false) }
# Descargar el estado de cuenta del perro abierto (CSV / Excel).
action facCSV { descargarEstadoCuentaCSV(cliente.facturaPerro, cliente.facturaNombre) }
action facXLS { descargarEstadoCuentaExcel(cliente.facturaPerro, cliente.facturaNombre) }

Stack class("dd-app") {

  Custom ClienteBridge on(misPerros: cliente.setMisPerros, misPaseos: cliente.setMisPaseos, misFotos: cliente.setMisFotos, novedades: cliente.setNovedades, salidas: cliente.setSalidas, servicios: cliente.setServicios, miResena: cliente.setMiResena, identidad: cliente.setIdentidad, loaded: cliente.setLoaded)
  Custom PoliticaBridge on(secciones: polSecs, meta: polMeta)
  Custom IncidentesBridge on(items: incidentes.setItems)
  Custom Toast
  # Vigía de red (O4): alimenta el aviso offline del shell.
  Custom NetWatch on(online: net.setOnline, pending: net.setPending)
  Custom SupaAuthForm inputs(mode: "watch") on(politica: auth.setPolitica)

  # ---------- SIDEBAR ----------
  Sidebar class("dd-side") {
    Stack class("dd-brand") { Span "D" class("dd-logo")  Span "DevDogs" class("dd-brandname") }
    Span "Cliente" class("dd-navlbl")
    Button -> go("dashboard") class("dd-lnk") class("dd-on" when section == "dashboard") { Icon "lucide:home"      Span "Inicio" }
    Button -> go("perros")    class("dd-lnk") class("dd-on" when section == "perros")    { Icon "lucide:dog"       Span "Mis perros" }
    Button -> go("reservar")  class("dd-lnk") class("dd-on" when section == "reservar")  { Icon "lucide:calendar-plus" Span "Reservar" }
    Button -> go("tienda")    class("dd-lnk") class("dd-on" when section == "tienda")    { Icon "lucide:shopping-bag" Span "Tienda" }
    Button -> go("agenda")    class("dd-lnk") class("dd-on" when section == "agenda")    { Icon "lucide:calendar"  Span "Agenda" }
    Button -> go("perfil")    class("dd-lnk") class("dd-on" when section == "perfil")    { Icon "lucide:user"      Span "Perfil" }
    Stack class("dd-foot") {
      Span "{initial(auth.userName)}" class("dd-ua")
      Stack { Span "{auth.userName}" class("dd-un")  Span "Cliente" class("dd-ur") }
    }
  }

  Stack class("dd-content") {
    Stack class("dd-screen") {
      # Who provides the service, on every screen: the business, not DevDogs (role notice, aviso_rol).
      Span "Servicio de {prestador}" class("dd-prov")

      # ==== INICIO: skeleton ====
      when section == "dashboard" and not cliente.loaded {
        Stack class("dd-sec skel-col") {
          Stack class("skel-row") {
            Stack class("skel-b skel-circle skel-av")
            Stack class("skel-col") { Stack class("skel-b skel-text-s")  Stack class("skel-b skel-text") }
          }
          Stack class("skel-b skel-heading")
          Stack class("skel-b skel-heading-sm")
          Stack class("skel-row") {
            Stack class("skel-b skel-circle skel-av-sm")
            Stack class("skel-b skel-circle skel-av-sm")
            Stack class("skel-b skel-circle skel-av-sm")
          }
          Stack class("skel-b skel-line")
          Stack class("skel-b skel-line")
          Stack class("skel-b skel-line")
        }
      }
      # ==== INICIO ====
      when section == "dashboard" and cliente.loaded {
        Stack class("dd-sec") {
          Stack class("dd-top") {
            Stack class("dd-greet") {
              Span "{initial(auth.userName)}" class("dd-ga")
              Stack { Span "Buen día 👋" class("dd-gm")  Span "{auth.userName}" class("dd-gn") }
            }
            Button -> notifToggle class("dd-bell dd-bell-count") aria(label: "Novedades") {
              Icon "lucide:bell"
              when nAvisos > 0 { Span "{nAvisos}" class("dd-bell-badge") }
            }
          }
          # Panel de novedades (notificaciones in-app).
          when notifOpen {
            Stack class("dd-cal-scrim") {
              Stack class("dd-cal-scrimbg") on(click: notifCerrar)
              Stack class("dd-cal-sheet") aria(role: "dialog", modal: true) {
                Stack class("dd-cat-formhead") {
                  Title "Novedades" h3
                  Button -> notifCerrar class("dd-cal-sheet-x") aria(label: "Cerrar") { Icon "lucide:x" }
                }
                when nAvisos == 0 {
                  Stack class("dd-ph") { Stack class("dd-pi") { Icon "lucide:bell" }  Text "Sin novedades por ahora." }
                }
                Stack class("dd-cat-list") {
                  each incidentes.items as i where i.grave {
                    Stack class("dd-notif dd-notif-grave") {
                      Stack class("dd-notif-ic") { Icon "lucide:triangle-alert" }
                      Stack class("dd-cat-info") {
                        Span "{i.tipo}: {i.perro}" class("nm")
                        Span "{i.descripcion}" class("meta")
                        Span "Reportado el {i.fecha} por {prestador}" class("meta")
                      }
                    }
                  }
                  each incidentes.items as i where i.reciente and not i.grave {
                    Stack class("dd-notif") {
                      Stack class("dd-notif-ic") { Icon "lucide:triangle-alert" }
                      Stack class("dd-cat-info") {
                        Span "{i.tipo}: {i.perro}" class("nm")
                        Span "{i.descripcion}" class("meta")
                        Span "Reportado el {i.fecha}" class("meta")
                      }
                    }
                  }
                  each cliente.novedades as n {
                    Button -> irAgenda class("dd-notif") {
                      Stack class("dd-notif-ic") {
                        when n.kind == "foto" { Icon "lucide:image" }
                        when n.kind == "hoy" { Icon "lucide:calendar-clock" }
                      }
                      Stack class("dd-cat-info") {
                        when n.kind == "hoy" { Span "Hoy {n.hora}: {n.servicio}" class("nm") }
                        when n.kind == "foto" { Span "Fotos del paseo de {n.perro} 📷" class("nm") }
                        Span "{n.perro} · {n.fecha}" class("meta")
                      }
                    }
                  }
                }
              }
            }
          }
          Stack class("dd-h1") aria(role: "heading", level: "1") {
            Span "{cliente.proximos} paseos"
            Span "próximos"
          }
          Stack class("dd-dogs-total") {
            Stack class("dd-dt-head") {
              Span "{cliente.nPerros} perros" class("dd-dt-label")
              Button -> go("reservar") class("dd-dt-add") aria(label: "Reservar") { Icon "lucide:plus" }
            }
            Stack class("dd-dt-row") {
              each cliente.misPerros.take(6) as p {
                Stack class("dd-dogav") {
                  when p.foto { Image "{p.foto}" alt("{p.nombre}") }
                  when p.foto == "" { Span "🐕" }
                }
              }
              when cliente.nPerros == 0 { Span "Sin perros aún" class("dd-dt-empty") }
            }
          }
          # Estado de cuenta: saldo pendiente (paseos realizados sin cobrar).
          when cliente.saldoPendiente > 0 {
            Button -> go("perros") class("dd-saldo") aria(label: "Ver estados de cuenta") {
              Stack class("dd-saldo-ic") { Icon "lucide:wallet" }
              Stack class("dd-saldo-info") {
                Span "Saldo pendiente" class("dd-saldo-l")
                Span "{cop(cliente.saldoPendiente)}" class("dd-saldo-v")
              }
              Icon "lucide:chevron-right" class("chev")
            }
          }

          Span "Próximos paseos" class("dd-emp-lbl")
          when cliente.proximos == 0 { Text "No tienes paseos próximos. Reserva uno." class("dd-cli-empty") }
          Stack class("dd-cat-list") {
            each cliente.misPaseos as p where p.futuro {
              Stack class("dd-cli-paseo") {
                Stack class("dd-cat-item") {
                  Stack class("dd-sv-ic") { Icon "lucide:calendar" }
                  Stack class("dd-cat-info") {
                    Stack class("nmline") { Span "{p.servicio}" class("nm")  Span "{p.estado}" class("cd") }
                    Span "{p.perro} · {p.fecha} {p.hora}" class("meta")
                  }
                  when p.cancelable { Button "Cancelar" -> cancelPedir(p.id) class("dd-cat-add") }
                }
                when cancelId == p.id {
                  Stack class("dd-cat-item") aria(role: "group", label: "Confirmar la cancelación") {
                    Text "¿Cancelar esta reserva? Las condiciones de cancelación las fija tu negocio." class("dd-cli-hint")
                    Stack class("acts") {
                      Button "Sí, cancelar" -> cancelConfirmar class("dd-cat-add dd-danger")
                      Button "No" -> cancelNo class("dd-cat-add")
                    }
                  }
                }
              }
            }
          }
        }
      }

      # ==== MIS PERROS ====
      when section == "perros" {
        Stack class("dd-sec") {
          Stack class("dd-cat-head") {
            Title "Mis perros" h2
            Button -> perroNuevo class("dd-cat-add") { Icon "lucide:plus"  Span "Registrar perro" }
          }
          when cliente.nPerros == 0 {
            Stack class("dd-ph") { Stack class("dd-pi") { Icon "lucide:dog" }  Title "Sin perros" h2  Text "Registra tu perro para reservar sus salidas y servicios." }
          }
          Stack class("dd-cat-list") {
            each cliente.misPerros as p {
              Stack class("dd-cat-item") {
                Stack class("av") {
                  when p.foto { Image "{p.foto}" alt("{p.nombre}") }
                  when p.foto == "" { Span "🐕" }
                }
                Stack class("dd-cat-info") {
                  Stack class("nmline") { Span "{p.nombre}" class("nm")  when p.celo { Span "En celo" class("dd-soc dd-soc-cuidado") }  when p.contagio { Span "Enfermedad contagiosa" class("dd-soc dd-soc-cuidado") } }
                  when p.raza { Span "{p.raza} · {p.tamano}" class("meta") }
                  Span "{estadoCertificado(p.certificado)}" class("meta dd-cert")
                  when p.plan { Span "{p.plan}" class("meta dd-plan") }
                }
                Stack class("acts") {
                  Button -> cliente.facturaAbrir(p.id, p.nombre) class("dd-cat-add dd-cli-facbtn") { Icon "lucide:file-text"  Span "Estado de cuenta" }
                }
              }
            }
          }
          when pform {
            Stack class("dd-cal-scrim") {
              Stack class("dd-cal-scrimbg") on(click: perroCerrar)
              Stack class("dd-cal-sheet") aria(role: "dialog", modal: true) {
                Stack class("dd-cat-formhead") {
                  Title "Registrar perro" h3
                  Button -> perroCerrar class("dd-cal-sheet-x") aria(label: "Cerrar") { Icon "lucide:x" }
                }
                Form bind(pdraft) submit(miPerroGuardar) "Guardar perro"
              }
            }
          }
        }
      }

      # ==== RESERVAR (acoplarse a las salidas) ====
      when section == "reservar" {
        Stack class("dd-sec") {
          Stack class("dd-cat-head") {
            Title "Reservar" h2
            Stack class("dd-org-toggle") aria(role: "group", label: "Qué reservar") {
              Button "Salidas" -> resTabSet("salidas") class("on" when resTab == "salidas")
              Button "Servicios" -> resTabSet("servicios") class("on" when resTab == "servicios")
            }
          }
          Span "Prestado por {prestador}" class("dd-prov-by")
          when resTab == "salidas" {
            Stack {
              Text "Elige una salida del negocio; tu perro se acopla a ese horario y zona." class("dd-cli-hint")
              when cliente.salidasReservables.length == 0 {
                Stack class("dd-ph") { Stack class("dd-pi") { Icon "lucide:calendar-plus" }  Title "Sin salidas" h2  Text "El negocio todavía no publicó salidas." }
              }
              Stack class("dd-cat-list") {
                each cliente.salidasReservables as s {
                  Stack class("dd-cat-item") {
                    Stack class("dd-sv-ic") { Icon "lucide:map-pin" }
                    Stack class("dd-cat-info") {
                      Stack class("nmline") { Span "{s.servicio}" class("nm")  when s.zona { Span "{s.zona}" class("cd") } }
                      Span "Sale {s.hora}" class("meta")
                    }
                    Stack class("acts") {
                      Button "Reservar" -> resAbrir(s.id, s.servicioId, s.hora, s.zona) class("dd-cat-add dd-cli-resbtn")
                    }
                  }
                }
              }
            }
          }

          # Otros servicios (baño, guardería, corte, vet…) — pedir un turno directo. Comida y snacks: la Tienda.
          when resTab == "servicios" {
            Stack {
              Text "Baño, guardería, corte de garras y más — pide un turno." class("dd-cli-hint")
              when cliente.nOtrosServicios == 0 { Text "El negocio aún no publicó otros servicios." class("dd-cli-empty") }
              Stack class("dd-cat-list") {
                each cliente.otrosServicios as sv {
                  Stack class("dd-cat-item") {
                    Stack class("dd-sv-ic") { Icon "lucide:sparkles" }
                    Stack class("dd-cat-info") {
                      Stack class("nmline") { Span "{sv.nombre}" class("nm")  Span "{tipoLabel(sv.tipo)}" class("cd") }
                      when sv.precio > 0 { Span "{cop(sv.precio)}" class("meta") }
                    }
                    Stack class("acts") {
                      Button "Pedir" -> svcAbrir(sv.id, sv.nombre) class("dd-cat-add dd-cli-resbtn")
                    }
                  }
                }
              }
            }
          }
        }
      }

      # ==== TIENDA (comida y snacks) ====
      when section == "tienda" {
        Stack class("dd-sec") {
          Stack class("dd-cat-head") { Title "Tienda" h2 }
          Text "Comida y snacks para tu perro. La compra queda en tu cuenta." class("dd-cli-hint")
          Span "Prestado por {prestador}" class("dd-prov-by")
          when cliente.nProductos == 0 {
            Stack class("dd-ph") { Stack class("dd-pi") { Icon "lucide:shopping-bag" }  Title "Sin productos" h2  Text "El negocio todavía no publicó productos." }
          }
          Stack class("dd-cat-list") {
            each cliente.servicios as sv where sv.tipo == "comida" or sv.tipo == "accesorio" {
              Stack class("dd-cat-item") {
                Stack class("dd-sv-ic") { Icon "lucide:package" }
                Stack class("dd-cat-info") {
                  Stack class("nmline") { Span "{sv.nombre}" class("nm")  Span "{tipoLabel(sv.tipo)}" class("cd") }
                  when sv.precio > 0 { Span "{cop(sv.precio)}" class("meta") }
                }
                Stack class("acts") {
                  Button "Comprar" -> prodAbrir(sv.id, sv.nombre) class("dd-cat-add dd-cli-resbtn")
                }
              }
            }
          }
        }
      }

      # ==== AGENDA (mis paseos) ====
      when section == "agenda" {
        Stack class("dd-sec") {
          Stack class("dd-cat-head") { Title "Agenda de paseos" h2 }
          Span "Prestado por {prestador}" class("dd-prov-by")
          when cliente.misPaseos.length == 0 {
            Stack class("dd-ph") { Stack class("dd-pi") { Icon "lucide:calendar" }  Title "Sin paseos" h2  Text "Todavía no hay paseos registrados." }
          }
          Stack class("dd-cat-list") {
            each cliente.misPaseos as p where not p.mensual {
              Stack class("dd-cli-paseo") {
                Stack class("dd-cat-item") class("dd-cli-past" when not p.futuro) {
                  Stack class("dd-sv-ic") { Icon "lucide:paw-print" }
                  Stack class("dd-cat-info") {
                    Stack class("nmline") { Span "{p.servicio}" class("nm")  Span "{p.estado}" class("cd") }
                    Span "{p.perro} · {p.fecha} {p.hora}" class("meta")
                    # Pickup and drop-off times the walker marked.
                    when p.recibido { Span "Recibido {p.recibido}" class("meta") }
                    when p.entrega { Span "Entregado {p.entrega}" class("meta") }
                  }
                  when p.cancelable { Button "Cancelar" -> cancelPedir(p.id) class("dd-cat-add") }
                }
                when cancelId == p.id {
                  Stack class("dd-cat-item") aria(role: "group", label: "Confirmar la cancelación") {
                    Text "¿Cancelar esta reserva? Las condiciones de cancelación las fija tu negocio." class("dd-cli-hint")
                    Stack class("acts") {
                      Button "Sí, cancelar" -> cancelConfirmar class("dd-cat-add dd-danger")
                      Button "No" -> cancelNo class("dd-cat-add")
                    }
                  }
                }
                # Fotos del paseo (si el paseador subió alguna).
                Stack class("dd-paseo-fotos-grid") {
                  each cliente.misFotos as ft where ft.paseoId == p.id {
                    Stack class("dd-foto-rep") {
                      Image "{ft.url}" alt("Foto del paseo de {p.perro}") class("dd-paseo-foto")
                      when repFoto != ft.id { Button "Reportar foto" -> repAbrir(ft.id) class("dd-gchip") }
                      when repFoto == ft.id {
                        Stack class("dd-gsvc") aria(role: "group", label: "Por qué reportas la foto") {
                          Button "Aparece una persona" -> repEnviar("aparece_persona") class("dd-gchip")
                          Button "Aparece un menor de edad" -> repEnviar("aparece_menor") class("dd-gchip")
                          Button "Otro motivo" -> repEnviar("otro") class("dd-gchip")
                          Button "Cancelar" -> repCerrar class("dd-gchip")
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }

      # ==== PERFIL ====
      when section == "perfil" {
        Stack class("dd-sec") {
          Stack class("dd-pf-hero") {
            Span "{initial(auth.userName)}" class("dd-pf-av")
            Span "{auth.userName}" class("dd-pf-name")
            Span "Cliente" class("dd-pf-role")
          }
          Stack class("dd-pf-stats") {
            Stack class("dd-pf-stat") { Span "{cliente.nPerros}" class("v")  Span "Perros" class("l") }
            Stack class("dd-pf-stat") { Span "{cliente.proximos}" class("v")  Span "Próximos" class("l") }
          }
          # Reseña del negocio: solo con al menos un servicio finalizado.
          when cliente.puedeResenar {
            Stack class("dd-rs") {
              Span "Tu reseña del negocio" class("dd-emp-lbl")
              each cliente.miResena as r {
                Stack class("dd-cat-item") {
                  Stack class("dd-cat-info") {
                    Stack class("nmline") {
                      Span "{r.rating} de 5 estrellas" class("nm")
                      match r.estado {
                        pendiente -> Span "Pendiente de aprobación" class("cd")
                        aprobada -> Span "Aprobada" class("cd")
                        rechazada -> Span "{r.motivo}" class("cd")
                      }
                    }
                    Span "{r.texto}" class("dd-rs-txt")
                    when not r.publicar { Span "No se publica: elegiste no mostrar tu nombre." class("obs") }
                  }
                  Stack class("acts") { Button "Editar" -> rsEditar(r.rating, r.texto, r.publicar) class("dd-cat-add") }
                }
              }
              when cliente.miResena.length == 0 { Button -> rsNueva class("dd-cat-add") { Icon "lucide:star"  Span "Dejar una reseña" } }
            }
          }
          # Ley 1480 art. 50 and 53: who provides the service, as the business recorded it.
          Stack class("dd-rs") {
            Span "Quién te presta el servicio" class("dd-emp-lbl")
            each cliente.identidad as n {
              Stack class("dd-perro-facts") {
                Stack class("dd-perro-fact") { Span "Nombre o razón social" class("k")  Span "{n.razon_social}" class("v") }
                Stack class("dd-perro-fact") {
                  match n.doc_tipo {
                    NIT -> Span "NIT" class("k")
                    CC  -> Span "Cédula de ciudadanía" class("k")
                    CE  -> Span "Cédula de extranjería" class("k")
                    PAS -> Span "Pasaporte" class("k")
                  }
                  Span "{n.doc_numero}" class("v")
                }
                Stack class("dd-perro-fact") { Span "Dirección de notificaciones" class("k")  Span "{n.direccion}" class("v") }
                Stack class("dd-perro-fact") { Span "Teléfono" class("k")  Span "{n.telefono}" class("v") }
                Stack class("dd-perro-fact") { Span "Correo" class("k")  Span "{n.correo}" class("v") }
              }
            }
            when cliente.identidad.length == 0 { Text "Tu negocio aún no registró sus datos legales." class("dd-rel-hint") }
          }
          # The policies the business published, which the client accepted (read-only).
          Stack class("dd-rs") {
            Span "Políticas de {prestador}" class("dd-emp-lbl")
            when polVer != "" { Button -> polAbrir class("dd-cat-add") { Icon "lucide:scroll-text"  Span "Ver las políticas" } }
            when polVer == "" { Text "Tu negocio aún no publicó sus políticas." class("dd-rel-hint") }
          }
          Stack class("dd-pf-list") { Link "" -> "/mis-datos" class("dd-pf-opt") { Icon "lucide:shield-check"  Span "Mis datos"  Icon "lucide:chevron-right" class("chev") } }
          SalirNegocio(abierto: salirNeg, onPedir: salirNegPedir, onSi: salirNegSi, onNo: salirNegNo)
          Button -> salir class("dd-pf-logout") { Icon "lucide:log-out"  Span "Cerrar sesión" }
        }
      }

      # ---- Modal: políticas del negocio (read-only) ----
      when polForm {
        Stack class("dd-cal-scrim") {
          Stack class("dd-cal-scrimbg") on(click: polCerrar)
          Stack class("dd-cal-sheet dd-pol-sheet") aria(role: "dialog", modal: true, label: polTitulo) {
            Stack class("dd-cat-formhead") {
              Span "Políticas" class("dd-emp-lbl")
              Button -> polCerrar class("dd-cal-sheet-x") aria(label: "Cerrar las políticas") { Icon "lucide:x" }
            }
            PoliticaNegocio(negocio: prestador, version: polVer, fecha: polFecha) {
              each secs as s {
                Section class("pv-sec") {
                  Title "{s.titulo}" h2
                  Text "{s.texto}" class("pv-pre")
                }
              }
            }
          }
        }
      }

      # ---- Modal: reservar ----
      when resForm {
        Stack class("dd-cal-scrim") {
          Stack class("dd-cal-scrimbg") on(click: resCerrar)
          Stack class("dd-cal-sheet") aria(role: "dialog", modal: true) {
            Stack class("dd-cat-formhead") {
              Title "Reservar en {resZona}" h3
              Button -> resCerrar class("dd-cal-sheet-x") aria(label: "Cerrar") { Icon "lucide:x" }
            }
            Stack class("dd-gform") {
              Text "Sale {resHora}" class("dd-cli-hint")
              Span "Prestado por {prestador}" class("dd-prov-by")
              Span "¿Qué perro?" class("dd-hor-lbl")
              Stack class("dd-gsvc") {
                each cliente.misPerros as p {
                  Button "{p.nombre}" -> resPickPerro(p.id) class("dd-gchip") class("on" when resPerro == p.id)
                }
                when cliente.nPerros == 0 { Span "No tienes perros asociados" class("dd-zn-empty") }
              }
              Span "Fecha" class("dd-hor-lbl")
              Date bind(resFecha)
              Button "Confirmar reserva" -> resConfirmar class("dd-cat-add dd-hor-save") disabled when resPerro == ""
            }
          }
        }
      }

      # ---- Modal: pedir un servicio (baño/guardería/corte/…) ----
      when svcForm {
        Stack class("dd-cal-scrim") {
          Stack class("dd-cal-scrimbg") on(click: svcCerrar)
          Stack class("dd-cal-sheet") aria(role: "dialog", modal: true) {
            Stack class("dd-cat-formhead") {
              Title "Pedir {svcNombre}" h3
              Button -> svcCerrar class("dd-cal-sheet-x") aria(label: "Cerrar") { Icon "lucide:x" }
            }
            Stack class("dd-gform") {
              Span "Prestado por {prestador}" class("dd-prov-by")
              Span "¿Qué perro?" class("dd-hor-lbl")
              Stack class("dd-gsvc") {
                each cliente.misPerros as p {
                  Button "{p.nombre}" -> svcPickPerro(p.id) class("dd-gchip") class("on" when svcPerro == p.id)
                }
                when cliente.nPerros == 0 { Span "No tienes perros asociados" class("dd-zn-empty") }
              }
              Span "Fecha" class("dd-hor-lbl")
              Date bind(svcFecha)
              Button "Confirmar" -> svcConfirmar class("dd-cat-add dd-hor-save") disabled when svcPerro == ""
            }
          }
        }
      }

      # ---- Modal: comprar un producto (comida/snack) ----
      when prodForm {
        Stack class("dd-cal-scrim") {
          Stack class("dd-cal-scrimbg") on(click: prodCerrar)
          Stack class("dd-cal-sheet") aria(role: "dialog", modal: true) {
            Stack class("dd-cat-formhead") {
              Title "Comprar {prodNombre}" h3
              Button -> prodCerrar class("dd-cal-sheet-x") aria(label: "Cerrar") { Icon "lucide:x" }
            }
            Stack class("dd-gform") {
              Span "Prestado por {prestador}" class("dd-prov-by")
              Span "¿Para qué perro?" class("dd-hor-lbl")
              Stack class("dd-gsvc") {
                each cliente.misPerros as p {
                  Button "{p.nombre}" -> prodPickPerro(p.id) class("dd-gchip") class("on" when prodPerro == p.id)
                }
                when cliente.nPerros == 0 { Span "No tienes perros asociados" class("dd-zn-empty") }
              }
              Span "Cantidad" class("dd-hor-lbl")
              Number bind(prodCantidad) min(1) max(20)
              Button "Confirmar compra" -> prodConfirmar class("dd-cat-add dd-hor-save") disabled when prodPerro == ""
            }
          }
        }
      }

      # ---- Modal: reseña del negocio ----
      when rsForm {
        Stack class("dd-cal-scrim") {
          Stack class("dd-cal-scrimbg") on(click: rsCerrar)
          Stack class("dd-cal-sheet") aria(role: "dialog", modal: true) {
            Stack class("dd-cat-formhead") {
              Title "Tu reseña" h3
              Button -> rsCerrar class("dd-cal-sheet-x") aria(label: "Cerrar") { Icon "lucide:x" }
            }
            Stack class("dd-gform") {
              Span "¿Cómo calificas el servicio?" class("dd-hor-lbl")
              Stack class("dd-rs-stars") {
                Button -> rsPick(1) class("on" when rsRating >= 1) aria(label: "1 estrella") { Icon "lucide:star" }
                Button -> rsPick(2) class("on" when rsRating >= 2) aria(label: "2 estrellas") { Icon "lucide:star" }
                Button -> rsPick(3) class("on" when rsRating >= 3) aria(label: "3 estrellas") { Icon "lucide:star" }
                Button -> rsPick(4) class("on" when rsRating >= 4) aria(label: "4 estrellas") { Icon "lucide:star" }
                Button -> rsPick(5) class("on" when rsRating >= 5) aria(label: "5 estrellas") { Icon "lucide:star" }
              }
              Span "Tu opinión" class("dd-hor-lbl")
              Textarea bind(rsTexto) "Cuéntanos cómo fue (mínimo 10 caracteres)"
              Checkbox bind(rsPublicar) "Acepto que mi reseña se publique con mi nombre"
              Text "Se muestra tu nombre y la inicial de tu apellido. Sin esta casilla, tu reseña no se publica." class("dd-rel-hint")
              Button "Enviar reseña" -> rsEnviar class("dd-cat-add dd-hor-save") disabled when rsRating == 0 or rsTexto.length < 10
            }
          }
        }
      }

      # ---- Estado de cuenta / registro del perro (la "libreta": ver en la app + CSV/Excel) ----
      when cliente.facturaPerro != "" {
        Stack class("dd-cal-scrim") {
          Stack class("dd-cal-scrimbg") on(click: cliente.facturaCerrar)
          Stack class("dd-cal-sheet dd-fac-sheet") aria(role: "dialog", modal: true) {
            Stack class("dd-cat-formhead") {
              Title "Estado de cuenta · {cliente.facturaNombre}" h3
              Button -> cliente.facturaCerrar class("dd-cal-sheet-x") aria(label: "Cerrar") { Icon "lucide:x" }
            }
            Stack class("dd-fac-meta") {
              Span "{auth.userName}" class("dueno")
              Span "{cliente.facturaCount} servicios" class("cnt")
            }
            Span "Prestado por {prestador}" class("dd-prov-by")
            Stack class("dd-fac-table") {
              Stack class("dd-fac-row dd-fac-head") {
                Span "Fecha" class("c-f")  Span "Servicio" class("c-s")  Span "Estado" class("c-e")  Span "Precio" class("c-p")
              }
              each cliente.facturaRows as p {
                Stack class("dd-fac-row") {
                  Span "{p.fecha}" class("c-f")
                  Span "{p.servicio}" class("c-s")
                  Span "{p.estado}" class("c-e")
                  when p.cobrable { Span "{cop(p.precio)}" class("c-p") }
                  when not p.cobrable { Span "Mensualidad" class("c-p men") }
                }
              }
              when cliente.facturaCount == 0 { Text "Sin servicios registrados para este perro." class("dd-cli-empty") }
            }
            Stack class("dd-fac-total") {
              Span "Total" class("l")
              Span "{cop(cliente.facturaTotal)}" class("v")
            }
            Text "Este documento no es una factura electrónica." class("dd-fac-legal")
            Stack class("dd-fac-actions") {
              Button -> facCSV class("dd-fac-exp") { Icon "lucide:download"  Span "CSV" }
              Button -> facXLS class("dd-fac-exp") { Icon "lucide:download"  Span "Excel" }
            }
          }
        }
      }
    }
  }

  # ---------- BOTTOM NAV ----------
  Nav class("dd-tabbar") {
    Button -> go("dashboard") class("dd-on" when section == "dashboard") aria(label: "Inicio") { Icon "lucide:home" }
    Button -> go("perros")    class("dd-on" when section == "perros")    aria(label: "Mis perros") { Icon "lucide:dog" }
    Button -> go("reservar")  class("dd-on" when section == "reservar")  aria(label: "Reservar") { Icon "lucide:calendar-plus" }
    Button -> go("tienda")    class("dd-on" when section == "tienda")    aria(label: "Tienda") { Icon "lucide:shopping-bag" }
    Button -> go("agenda")    class("dd-on" when section == "agenda")    aria(label: "Agenda") { Icon "lucide:calendar" }
    Button -> go("perfil")    class("dd-on" when section == "perfil")    aria(label: "Perfil") { Icon "lucide:user" }
  }
}
