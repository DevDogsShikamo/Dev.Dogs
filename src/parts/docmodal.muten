# Modal that shows one legal document (the caller's children) and unlocks its accept button only once the
# reader reaches the end. onLeer runs on every scroll of the body, and on a pointer or focus event inside
# the panel so a document short enough to fit without scrolling unlocks too (alFinal is true then); the
# caller flips `leido` when alFinal("dd-politica-doc") holds. Used by Consentimiento and /aceptar-condiciones.
part DocModal(titulo: text, aceptar: text, leido: bool, onCerrar: action, onLeer: action, onAceptar: action) {
  Stack class("pm-overlay") {
    Stack class("pm-panel") aria(role: "dialog", modal: true, label: "{$titulo}") on(pointermove: $onLeer, pointerdown: $onLeer, focusin: $onLeer) {
      Stack class("pm-head") {
        Span "{$titulo}" class("pm-title")
        Button -> $onCerrar class("pm-x") aria(label: "Cerrar los documentos") { Icon "lucide:x" }
      }
      Stack id("dd-politica-doc") class("pm-body") on(scroll: $onLeer) {
        slot
      }
      Stack class("pm-foot") {
        # `disabled when` does not take part params, so the locked and unlocked buttons are two branches.
        when not $leido {
          Stack class("pm-foot-in") {
            Text "Desplázate hasta el final del documento para poder aceptar." class("pm-hint")
            Button "{$aceptar}" class("pm-ok") disabled
          }
        }
        when $leido { Button "{$aceptar}" -> $onAceptar class("pm-ok") }
      }
    }
  }
}
