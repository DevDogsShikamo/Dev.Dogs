# Appointments, backed by Supabase (table public.citas). Rows load via SupaData;
# writes go through data.ts use-fns which persist + trigger a refresh.
use persistPagado, persistHecho from "~/lib/data.ts"

entity Cita {
  hora      text
  cliente   text
  perro     text
  servicio  text
  svcClass  text
  direccion text
  precio    number
  hecho     bool
  pagado    bool
}

state {
  citas = [] : list<Cita>
}

get total       = citas.length
get hechos      = citas.count where hecho
get pendientes  = citas.count where not hecho
get ingresoDia  = citas.sum by precio
get pagadas     = citas where pagado
get cobrado     = pagadas.sum by precio
get sinPagar    = citas where not pagado
get porCobrar   = sinPagar.sum by precio

action setCitas(rows: list<Cita>) mutates citas { citas.set(rows) }

action marcarHecho(cid: text)  mutates citas { citas.patch where id == cid with { hecho: true }   persistHecho(cid) }
action marcarPagado(cid: text) mutates citas { citas.patch where id == cid with { pagado: true }  persistPagado(cid) }
