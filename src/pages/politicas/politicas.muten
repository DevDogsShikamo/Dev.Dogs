screen politicas

use politicaVersion, condicionesVersion, irAlAncla from "~/lib/politica.js"

meta {
  title       "Términos y políticas | DevDogs"
  description "Términos de uso, tratamiento de datos, almacenamiento en el dispositivo, fotos, reseñas, bienestar animal y atención al usuario de DevDogs. Borrador pendiente de revisión legal."
  lang        "es"
}

# Public legal center. DRAFT for a lawyer: every statement about the app was checked against the code
# (roles, RPCs, RLS, persisted keys, photo Worker); unknown company facts are [COMPLETAR: ...] markers.
# The data-treatment policy is the shared part PoliticaTexto (same text the consent modal shows); when
# that text changes, bump POLITICA_VERSION and add the `politicas` row. The documents themselves live in
# the part DocumentosLegales, which the consent modal also shows: one version covers terms + data policy.

get version = politicaVersion()
# The business terms are accepted apart (aceptaciones), with their own version.
get versionNegocios = condicionesVersion("terminos_negocio")
effect { irAlAncla() }

Page class("pv") {
  Stack class("pv-wrap") {
    Link "← Volver a DevDogs" -> "/" class("glink t-sm")

    Stack class("pv-draft") {
      Span "BORRADOR — pendiente de revisión legal" class("pv-draft-t")
      Text "Este conjunto de documentos es un borrador preparado para que lo revise un abogado. Aún no ha sido aprobado, no está en vigor y no debe entenderse como garantía de adecuación legal. Los datos que todavía no se conocen aparecen entre corchetes con la indicación COMPLETAR." class("pv-draft-d")
    }

    Title "Términos y políticas de DevDogs" h1 class("pv-h1")
    Text "Aquí está, en un solo lugar y en lenguaje claro, todo lo que rige el uso de DevDogs: qué es la plataforma, qué hace y qué no hace, cómo se tratan los datos, qué se guarda en el dispositivo, cómo funcionan las fotos y las reseñas, qué exige el cuidado de los perros y cómo presentar una petición, queja o reclamo." class("pv-lead")
    Text "Versión de estos documentos: {version}" class("pv-meta")
    Text "Fecha de entrada en vigor de estos documentos: [COMPLETAR: fecha, una vez aprobados por el abogado]" class("pv-meta")

    Nav class("pl-toc") aria(label: "Contenido") {
      Span "Contenido" class("pl-toc-t")
      Link "Resumen en un minuto" -> "#resumen" class("pl-toc-a")
      Link "1. Términos y condiciones de uso" -> "#terminos" class("pl-toc-a")
      Link "2. Servicios, precios, cobros y cancelaciones" -> "#servicios" class("pl-toc-a")
      Link "3. Bienestar animal y seguridad del servicio" -> "#bienestar" class("pl-toc-a")
      Link "4. Fotos de los paseos" -> "#fotos" class("pl-toc-a")
      Link "5. Reseñas" -> "#resenas" class("pl-toc-a")
      Link "6. Lo que se guarda en su dispositivo" -> "#dispositivo" class("pl-toc-a")
      Link "7. Peticiones, quejas, reclamos y derechos" -> "#atencion" class("pl-toc-a")
      Link "8. Política de tratamiento de datos personales" -> "#datos" class("pl-toc-a")
      Link "9. Marco legal de referencia" -> "#marco" class("pl-toc-a")
      Link "10. Términos para negocios" -> "#negocios" class("pl-toc-a")
    }

    DocumentosLegales(version: version)

    # ---- 10. Business terms: accepted only by business owners, at the /aceptar-condiciones gate ----
    Section id("negocios") class("pv-sec pl-doc") {
      Title "10. Términos para negocios" h2
      Text "Los acepta, aparte de los documentos anteriores, quien registra un negocio en DevDogs (empresa o paseador independiente)."
      TerminosNegocio(version: versionNegocios)
    }
  }
}
