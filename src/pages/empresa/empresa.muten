screen empresa
use cop from "~/lib/money.ts"
use paseadorSalario, permisoFinanzas, invitarCrear, invitacionQuitar, grupoAsignar, cobroMarcar, servicioCrear, servicioActualizar, servicioEliminar, perroCrear, perroActualizar, perroEliminar, coduenioAgregar, coduenioQuitar, grupoCrear, grupoActualizar, grupoEliminar, resenaModerar, negocioIdentidadGuardar, negocioPoliticaPublicar from "~/lib/data.ts"
use politicaEditable, politicaError from "~/lib/politicaNegocio.js"
use copiarCodigo, copiarLink from "~/lib/share.ts"
use tipoLabel from "~/lib/svc.ts"
use estadoCertificado from "~/lib/kiara.js"

# Draft del servicio (alta/edición) — el Form de Muten necesita page-state.
entity ServicioDraft {
  nombre   text required
  tipo     paseo | guarderia | bano | corte | adiestramiento | veterinaria | comida | accesorio
  duracion number
  precio   number
  modelo   por_uso | mensual
}
# Draft del perro (alta/edición).
entity PerroDraft {
  nombre       text required
  raza         text
  tamano       pequeno | mediano | grande
  conducta     tranquilo | energico | reactivo | sociable | jalador
  sociabilidad excelente | bueno | cuidado | selectivo
  # Ley 2480 de 2025: in heat (stays home from walks and daycare) + health certificate issue date.
  celo         bool
  certificado  date
  tips         text
  foto         text
}

# Legal identity of the business (Ley 1480 art. 50 and 53): 0 or 1 row from the bridge.
entity NegocioLegal { razon_social text  doc_tipo text  doc_numero text  direccion text  telefono text  correo text }
# Policies of the business (PoliticaBridge): the published sections and {version, fecha}; the editor rows.
entity PolSec { clave text  titulo text  texto text }
entity PolMeta { version text  fecha text }
entity PolEdit { clave text  titulo text  texto text  req bool }

# Portal EMPRESA — panel a nivel negocio: agrega sobre muchos paseadores y clientes.
# Reutiliza la estética .dd-* del panel del paseador. Datos: EmpresaBridge (una vez
# en el root) + store `empresa`. Fase 2: gestión (salario + invitaciones).

state {
  section = "dashboard" : text
  salEdit   = "" : text
  salNombre = "" : text
  salVal    = 0  : number
  salForm   = false : bool
  invRol    = "paseador" : text
  invEmail  = "" : text
  invForm   = false : bool
  asigSalida = "" : text
  asigNombre = "" : text
  asigForm   = false : bool
  sdraft   = {} : ServicioDraft
  sedit    = "" : text
  sform    = false : bool
  pdraft   = {} : PerroDraft
  pedit    = "" : text
  pform    = false : bool
  gnombre  = "" : text
  gzona    = "" : text
  ghora    = 8  : number
  gdur     = 60 : number
  gservicio = "" : text
  gcolor   = "purple" : text
  gedit    = "" : text
  gform    = false : bool
  # Legal identity editor (owner only; not persisted).
  lrazon  = "" : text
  ltipo   = "NIT" : text
  lnum    = "" : text
  ldir    = "" : text
  ltel    = "" : text
  lcorreo = "" : text
  lhay    = false : bool
  # Business policies editor (owner only; not persisted): one row per section.
  pol      = [] : list<PolEdit>
  polVer   = "" : text
  polFecha = "" : text
}
action go(s: text) mutates section { section.set(s) }
# Logout: limpia el cache del negocio (dispositivo compartido) y cierra sesión.
action salir { catalogo.limpiar()  servicios.limpiar()  empresa.limpiar()  auth.logout() }

# ---- Legal identity of the business (owner only; the RPC validates) ----
action idCargar(rows: list<NegocioLegal>) mutates lrazon, ltipo, lnum, ldir, ltel, lcorreo, lhay {
  if rows.length > 0 { lrazon.set(rows.at(0).razon_social)  ltipo.set(rows.at(0).doc_tipo)  lnum.set(rows.at(0).doc_numero)  ldir.set(rows.at(0).direccion)  ltel.set(rows.at(0).telefono)  lcorreo.set(rows.at(0).correo)  lhay.set(true) }
}
action idTipo(t: text) mutates ltipo { ltipo.set(t) }
action idGuardar { negocioIdentidadGuardar(lrazon, ltipo, lnum, ldir, ltel, lcorreo) }

# ---- Policies of the business (owner only; the RPC validates and publishes version n+1) ----
action polCargar(rows: list<PolSec>) mutates pol { pol.set(politicaEditable(rows)) }
action polMeta(rows: list<PolMeta>) mutates polVer, polFecha {
  if rows.length > 0 { polVer.set(rows.at(0).version)  polFecha.set(rows.at(0).fecha) }
}
get polError = politicaError(pol)
action polPublicar { negocioPoliticaPublicar(pol) }

# ---- Catálogo de servicios (ABM del jefe) ----
action servicioNuevo mutates sdraft, sedit, sform { sdraft.reset()  sedit.set("")  sform.set(true) }
action servicioEditar(id: text, nombre: text, tipo: text, duracion: number, precio: number, modelo: text) mutates sdraft, sedit, sform {
  sdraft.set({ nombre: nombre, tipo: tipo, duracion: duracion, precio: precio, modelo: modelo })
  sedit.set(id)  sform.set(true)
}
action servicioCerrar mutates sform { sform.set(false) }
action servicioGuardar(s: ServicioDraft) mutates sform {
  if sedit == "" { servicioCrear(s) }
  else { servicios.servicioUpd(sedit, s.nombre, s.tipo, s.duracion, s.precio, s.modelo)  servicioActualizar(sedit, s) }
  sform.set(false)
}
action servicioBorrar(id: text) { servicios.servicioDel(id)  servicioEliminar(id) }

# ---- Catálogo de perros (ABM del jefe) ----
action perroNuevo mutates pdraft, pedit, pform { pdraft.reset()  pedit.set("")  pform.set(true) }
action perroEditar(id: text, nombre: text, raza: text, tamano: text, conducta: text, soc: text, tips: text, foto: text, celo: bool, cert: text) mutates pdraft, pedit, pform {
  pdraft.set({ nombre: nombre, raza: raza, tamano: tamano, conducta: conducta, sociabilidad: soc, celo: celo, certificado: cert, tips: tips, foto: foto })
  pedit.set(id)  pform.set(true)
}
action perroCerrar mutates pform { pform.set(false) }
action perroGuardar(p: PerroDraft) mutates pform {
  if pedit == "" { perroCrear(p) }
  else { catalogo.perroPatch(pedit, p.nombre, p.raza, p.tamano, p.conducta, p.sociabilidad, p.tips, p.foto, p.celo, p.certificado)  perroActualizar(pedit, p) }
  pform.set(false)
}
action perroBorrar(id: text) { catalogo.perroQuitar(id)  perroEliminar(id) }
# Co-dueños: solo el jefe (RPC coduenio_*); el perro es el que está abierto en el form.
action coAgregar(did: text) { coduenioAgregar(pedit, did) }
action coQuitar(did: text) { coduenioQuitar(pedit, did) }

# ---- Salidas / grupos (ABM del jefe) ----
action grupoNuevo mutates gnombre, gzona, ghora, gdur, gservicio, gcolor, gedit, gform {
  gnombre.set("")  gzona.set("")  ghora.set(8)  gdur.set(60)  gservicio.set("")  gcolor.set("purple")  gedit.set("")  gform.set(true)
}
action grupoEditar(id: text, nombre: text, zona: text, hora: number, dur: number, servicio: text, color: text) mutates gnombre, gzona, ghora, gdur, gservicio, gcolor, gedit, gform {
  gnombre.set(nombre)  gzona.set(zona)  ghora.set(hora)  gdur.set(dur)  gservicio.set(servicio)  gcolor.set(color)  gedit.set(id)  gform.set(true)
}
action gpickServicio(id: text, dur: number) mutates gservicio, gdur { gservicio.set(id)  gdur.set(dur) }
action gpickZona(z: text) mutates gzona { gzona.set(z) }
action gpickColor(c: text) mutates gcolor { gcolor.set(c) }
action grupoCerrar mutates gform { gform.set(false) }
action grupoGuardar mutates gform {
  if gedit == "" { grupoCrear(gnombre, gzona, ghora, gdur, gservicio, gcolor) }
  else { grupoActualizar(gedit, gnombre, gzona, ghora, gdur, gservicio, gcolor) }
  gform.set(false)
}
action grupoBorrar(id: text) { empresa.salidaDel(id)  grupoEliminar(id) }

# ---- Editar salario del paseador (optimista) ----
action salAbrir(id: text, nombre: text, sal: number) mutates salEdit, salNombre, salVal, salForm { salEdit.set(id)  salNombre.set(nombre)  salVal.set(sal)  salForm.set(true) }
action salCerrar mutates salForm { salForm.set(false) }
action salGuardar mutates salForm { empresa.salarioSet(salEdit, salVal)  paseadorSalario(salEdit, salVal)  salForm.set(false) }

# ---- Invitar paseador / cliente ----
action invAbrir(rol: text) mutates invRol, invEmail, invForm { invRol.set(rol)  invEmail.set("")  invForm.set(true) }
get invValido = invEmail.length > 4
action invCerrar mutates invForm { invForm.set(false) }
action invGuardar mutates invForm { invitarCrear(invRol, invEmail)  invForm.set(false) }
action invBorrar(id: text) { empresa.invitaDel(id)  invitacionQuitar(id) }
# El código recién creado se muestra una vez (empresa.codigoNuevo): copiar el código o un link con el código precargado.
action copCod(c: text) { copiarCodigo(c) }
action copLink(c: text) { copiarLink(c) }

# ---- Asignar paseador a una salida (optimista) ----
action asigAbrir(id: text, nombre: text) mutates asigSalida, asigNombre, asigForm { asigSalida.set(id)  asigNombre.set(nombre)  asigForm.set(true) }
action asigCerrar mutates asigForm { asigForm.set(false) }
action asigElegir(cid: text, cnom: text) mutates asigForm { empresa.asignarSet(asigSalida, cid, cnom)  grupoAsignar(asigSalida, cid)  asigForm.set(false) }

# ---- Cobrar un paseo pendiente (optimista + persiste) ----
action cobrar(id: text) { empresa.cobroDel(id)  cobroMarcar(id) }

# ---- Permiso de finanzas de la oficina (solo el dueño; optimista + RPC) ----
action finanzasToggle(id: text, on: bool) { empresa.finanzasSet(id, on)  permisoFinanzas(id, on) }

# ---- Moderar una reseña (solo el dueño; optimista + RPC) ----
action moderar(id: text, estado: text) { empresa.resenaSet(id, estado)  resenaModerar(id, estado) }

Stack class("dd-app") {

  # Puente de datos del negocio (montado una vez).
  Custom PoliticaBridge on(secciones: polCargar, meta: polMeta)
  Custom Toast
  Custom EmpresaBridge on(paseadores: empresa.setPaseadores, clientes: empresa.setClientes, gestion: empresa.setGestion, perros: catalogo.setPerros, perrosTot: empresa.setPerrosTot, duenos: empresa.setDuenos, stats: empresa.setStats, invitaciones: empresa.setInvitaciones, resenas: empresa.setResenas, codigoNuevo: empresa.setCodigoNuevo, identidad: idCargar, servicios: servicios.setServicios, zonas: servicios.setZonas, loaded: empresa.setLoaded)
  Custom ReportesBridge on(finanzas: empresa.setFinanzas, ingresosDia: empresa.setIngresosDia, topServicios: empresa.setTopServicios, porPaseador: empresa.setPorPaseador, pendientes: empresa.setPendientes, permiso: auth.setFinanzas)
  Custom SalidasBridge on(salidas: empresa.setSalidas)
  # Agenda semanal multi-paseador (#5).
  Custom AgendaEmpresaBridge on(agendaDias: empresa.setAgendaDias, agenda: empresa.setAgenda)
  # Vigía de red (O4): alimenta el aviso offline del shell.
  Custom NetWatch on(online: net.setOnline, pending: net.setPending)

  # ---------- SIDEBAR (escritorio) ----------
  Sidebar class("dd-side") {
    Stack class("dd-brand") { Span "D" class("dd-logo")  Span "DevDogs" class("dd-brandname") }
    Span "Empresa" class("dd-navlbl")
    Button -> go("dashboard")  class("dd-lnk") class("dd-on" when section == "dashboard")  { Icon "lucide:home"        Span "Inicio" }
    Button -> go("paseadores") class("dd-lnk") class("dd-on" when section == "paseadores") { Icon "lucide:users"       Span "Paseadores" }
    Button -> go("clientes") class("dd-lnk") class("dd-on" when section == "clientes") { Icon "lucide:user-round"  Span "Clientes" }
    Button -> go("salidas")    class("dd-lnk") class("dd-on" when section == "salidas")    { Icon "lucide:map-pin"     Span "Salidas" }
    Button -> go("agenda")     class("dd-lnk") class("dd-on" when section == "agenda")     { Icon "lucide:calendar"    Span "Agenda" }
    when auth.isOwner {
      Button -> go("servicios") class("dd-lnk") class("dd-on" when section == "servicios") { Icon "lucide:tag" Span "Servicios" }
    }
    when auth.isOwner {
      Button -> go("perros") class("dd-lnk") class("dd-on" when section == "perros") { Icon "lucide:dog" Span "Perros" }
    }
    when auth.isOwner {
      Button -> go("resenas") class("dd-lnk") class("dd-on" when section == "resenas") { Icon "lucide:star" Span "Reseñas" }
    }
    when auth.verFinanzas {
      Button -> go("reportes") class("dd-lnk") class("dd-on" when section == "reportes") { Icon "lucide:bar-chart-3" Span "Reportes" }
    }
    Button -> go("perfil")     class("dd-lnk") class("dd-on" when section == "perfil")     { Icon "lucide:user"        Span "Perfil" }
    Stack class("dd-foot") {
      Span "{initial(auth.userName)}" class("dd-ua")
      Stack { Span "{auth.userName}" class("dd-un")  when auth.isOwner { Span "Dueño" class("dd-ur") }  when auth.isGestion { Span "Gestión" class("dd-ur") } }
    }
  }

  # ---------- CONTENIDO ----------
  Stack class("dd-content") {
    Stack class("dd-screen") {

      # ==== INICIO: skeleton ====
      when section == "dashboard" and not empresa.loaded {
        Stack class("dd-sec skel-col") {
          Stack class("skel-row") {
            Stack class("skel-b skel-circle skel-av")
            Stack class("skel-col") { Stack class("skel-b skel-text-s")  Stack class("skel-b skel-text") }
          }
          Stack class("skel-b skel-heading")
          Stack class("skel-b skel-heading-sm")
          Stack class("skel-row") { Stack class("skel-b skel-kpi")  Stack class("skel-b skel-kpi")  Stack class("skel-b skel-kpi") }
          Stack class("skel-b skel-line")
          Stack class("skel-row") { Stack class("skel-b skel-kpi")  Stack class("skel-b skel-kpi")  Stack class("skel-b skel-kpi") }
        }
      }
      # ==== INICIO (métricas del negocio) ====
      when section == "dashboard" and empresa.loaded {
        Stack class("dd-sec") {
          Stack class("dd-top") {
            Stack class("dd-greet") {
              Span "{initial(auth.userName)}" class("dd-ga")
              Stack { Span "Buen día 👋" class("dd-gm")  Span "{auth.userName}" class("dd-gn") }
            }
          }

          Stack class("dd-h1") aria(role: "heading", level: "1") {
            Span "{empresa.paseosHoy} paseos"
            Span "hoy en el negocio"
          }

          Stack class("dd-emp-kpis") {
            Button -> go("paseadores") class("dd-emp-kpi") { Icon "lucide:users"       Span "{empresa.nPaseadores}" class("v")  Span "Paseadores" class("l") }
            when auth.isOwner {
              Button -> go("clientes") class("dd-emp-kpi") { Icon "lucide:user-round"  Span "{empresa.nClientes}" class("v")    Span "Clientes" class("l") }
            }
            when auth.isOwner {
              Button -> go("perros") class("dd-emp-kpi")     { Icon "lucide:dog"         Span "{empresa.perrosTot}" class("v")    Span "Perros" class("l") }
            }
          }

          Span "Paseos de hoy" class("dd-emp-lbl")
          Stack class("dd-emp-estados") {
            Stack class("dd-emp-est e-prog")  { Span "{empresa.programados}" class("v")  Span "Programados" class("l") }
            Stack class("dd-emp-est e-curso") { Span "{empresa.enCurso}" class("v")      Span "En curso" class("l") }
            Stack class("dd-emp-est e-fin")   { Span "{empresa.finalizados}" class("v")  Span "Finalizados" class("l") }
          }
        }
      }

      # ==== PASEADORES ====
      when section == "paseadores" {
        Stack class("dd-sec") {
          Stack class("dd-cat-head") {
            Title "Paseadores" h2
            when auth.isOwner {
              Button -> invAbrir("paseador") class("dd-cat-add") { Icon "lucide:user-plus"  Span "Invitar" }
            }
          }
          # Invitaciones pendientes (paseador) — solo el jefe las gestiona.
          when auth.isOwner {
            each empresa.invitaciones as iv where iv.rol == "paseador" {
              InviteItem(iv: iv, onDelete: invBorrar)
            }
          }
          when empresa.nPaseadores == 0 {
            Stack class("dd-ph") { Stack class("dd-pi") { Icon "lucide:users" }  Title "Sin paseadores" h2  Text "Invitá a tu primer paseador con el botón de arriba." }
          }
          Stack class("dd-cat-list") {
            each empresa.paseadores as p {
              Stack class("dd-cat-item") {
                Stack class("av") { Span "{initial(p.nombre)}" }
                Stack class("dd-cat-info") {
                  Stack class("nmline") {
                    Span "{p.nombre}" class("nm")
                    when p.verificado { Span "✓" class("dd-emp-ver") }
                  }
                  when auth.isOwner { Span "{p.paseosHoy} paseos hoy · {cop(p.salario)}/mes" class("meta") }
                  when auth.isGestion { Span "{p.paseosHoy} paseos hoy" class("meta") }
                  when p.telefono { Span "{p.telefono}" class("obs") }
                }
                when auth.isOwner {
                  Stack class("acts") {
                    Button -> salAbrir(p.id, p.nombre, p.salario) class("dd-cat-icon") aria(label: "Editar salario de {p.nombre}") { Icon "lucide:pencil" }
                  }
                }
              }
            }
          }
        }
      }

      # ==== CLIENTES ====
      when section == "clientes" {
        Stack class("dd-sec") {
          Stack class("dd-cat-head") {
            Title "Clientes" h2
            when auth.isOwner { Button -> invAbrir("cliente") class("dd-cat-add") { Icon "lucide:user-plus"  Span "Invitar" } }
          }
          each empresa.invitaciones as iv where iv.rol == "cliente" {
            InviteItem(iv: iv, onDelete: invBorrar)
          }
          when empresa.nClientes == 0 {
            Stack class("dd-ph") { Stack class("dd-pi") { Icon "lucide:user-round" }  Title "Sin clientes" h2  Text "Invitá a tu primer cliente con el botón de arriba." }
          }
          Stack class("dd-cat-list") {
            each empresa.clientes as c {
              Stack class("dd-cat-item") {
                Stack class("av") { Span "{initial(c.nombre)}" }
                Stack class("dd-cat-info") {
                  Stack class("nmline") { Span "{c.nombre}" class("nm") }
                  when c.telefono { Span "{c.telefono}" class("meta") }
                }
              }
            }
          }
        }
      }

      # ==== SALIDAS (asignar paseador) ====
      when section == "salidas" {
        Stack class("dd-sec") {
          Stack class("dd-cat-head") {
            Title "Salidas" h2
            when auth.isOwner {
              Button -> grupoNuevo class("dd-cat-add") { Icon "lucide:plus"  Span "Agregar" }
            }
          }
          when empresa.salidas.length == 0 {
            Stack class("dd-ph") { Stack class("dd-pi") { Icon "lucide:map-pin" }  Title "Sin salidas" h2  Text "No hay salidas configuradas en el negocio." }
          }
          Stack class("dd-cat-list") {
            each empresa.salidas as s {
              Stack class("dd-cat-item") {
                Stack class("dd-sv-ic") { Icon "lucide:map-pin" }
                Stack class("dd-cat-info") {
                  Stack class("nmline") { Span "{s.nombre}" class("nm")  when s.zona { Span "{s.zona}" class("cd") } }
                  Span "{s.hora} · {s.servicio}" class("meta")
                  when s.cuidadorNombre { Span "Paseador: {s.cuidadorNombre}" class("obs") }
                  when s.cuidadorNombre == "" { Span "Sin asignar" class("dd-sal-sin") }
                }
                Stack class("acts") {
                  Button -> asigAbrir(s.id, s.nombre) class("dd-cat-icon") aria(label: "Asignar paseador a {s.nombre}") { Icon "lucide:user-cog" }
                  when auth.isOwner {
                    Button -> grupoEditar(s.id, s.nombre, s.zona, s.horaNum, s.duracion, s.servicioId, s.color) class("dd-cat-icon") aria(label: "Editar salida") { Icon "lucide:pencil" }
                  }
                  when auth.isOwner {
                    Button -> grupoBorrar(s.id) class("dd-cat-icon dd-danger") aria(label: "Eliminar salida") { Icon "lucide:trash-2" }
                  }
                }
              }
            }
          }

          # Form crear/editar salida (jefe).
          when gform {
            Stack class("dd-cal-scrim") {
              Stack class("dd-cal-scrimbg") on(click: grupoCerrar)
              Stack class("dd-cal-sheet") aria(role: "dialog", modal: true) {
                Stack class("dd-cat-formhead") {
                  Title "Datos de la salida" h3
                  Button -> grupoCerrar class("dd-cal-sheet-x") aria(label: "Cerrar") { Icon "lucide:x" }
                }
                Stack class("dd-gform") {
                  Span "Nombre" class("dd-hor-lbl")
                  SearchField bind(gnombre) "Salida Chapinero"
                  Span "Zona" class("dd-hor-lbl")
                  Stack class("dd-gsvc") {
                    each servicios.zonas as z {
                      Button "{z}" -> gpickZona(z) class("dd-gchip") class("on" when gzona == z)
                    }
                    when servicios.zonas.length == 0 { Span "Sin zonas definidas" class("dd-zn-empty") }
                  }
                  Stack class("dd-grow") {
                    Stack class("dd-gcol") { Span "Hora" class("dd-hor-lbl")  Number bind(ghora) min(5) max(21) }
                    Stack class("dd-gcol") { Span "Duración (min)" class("dd-hor-lbl")  Number bind(gdur) min(15) max(240) }
                  }
                  Span "Servicio" class("dd-hor-lbl")
                  Stack class("dd-gsvc") {
                    Button "Sin servicio" -> gpickServicio("", gdur) class("dd-gchip") class("on" when gservicio == "")
                    each servicios.servicios as sv {
                      Button "{sv.nombre}" -> gpickServicio(sv.id, sv.duracion) class("dd-gchip") class("on" when gservicio == sv.id)
                    }
                  }
                  Span "Color" class("dd-hor-lbl")
                  Stack class("dd-gcolors") {
                    Button -> gpickColor("purple") class("dd-gcolor dd-gc-purple") class("on" when gcolor == "purple") { Span "" class("sw") }
                    Button -> gpickColor("blue") class("dd-gcolor dd-gc-blue") class("on" when gcolor == "blue") { Span "" class("sw") }
                    Button -> gpickColor("green") class("dd-gcolor dd-gc-green") class("on" when gcolor == "green") { Span "" class("sw") }
                    Button -> gpickColor("yellow") class("dd-gcolor dd-gc-yellow") class("on" when gcolor == "yellow") { Span "" class("sw") }
                  }
                  Button "Guardar salida" -> grupoGuardar class("dd-cat-add dd-hor-save")
                }
              }
            }
          }
        }
      }

      # ==== AGENDA (semana, multi-paseador) ====
      when section == "agenda" {
        Stack class("dd-sec") {
          Stack class("dd-cat-head") { Title "Agenda de la semana" h2 }
          when empresa.nAgenda == 0 {
            Stack class("dd-ph") { Stack class("dd-pi") { Icon "lucide:calendar" }  Title "Sin salidas" h2  Text "No hay salidas programadas esta semana." }
          }
          each empresa.agendaDias as day where day.count > 0 {
            Stack class("dd-agrp") {
              Span "{day.label}" class("dd-agrp-h")
              each empresa.agenda as e where e.fecha == day.fecha {
                Stack class("dd-agrp-item") {
                  Span "" class("dd-cal-dot-{e.color} dd-agrp-dot")
                  Span "{e.hora}" class("dd-agrp-hora")
                  Stack class("dd-agrp-info") {
                    Span "{e.servicio}" class("nm")
                    Span "{e.cuidador} · {e.dogs} 🐕" class("meta")
                  }
                  Span "{e.estado}" class("dd-agrp-badge b-{e.estado}")
                }
              }
            }
          }
        }
      }

      # ==== REPORTES / COBROS ====
      when section == "reportes" {
        Stack class("dd-sec") {
          Stack class("dd-cat-head") { Title "Reportes" h2 }
          Stack class("dd-emp-kpis") {
            Stack class("dd-emp-kpi dd-rep-kpi") { Icon "lucide:wallet"        Span "{cop(empresa.facturado)}" class("v")  Span "Total del periodo (30d)" class("l") }
            Stack class("dd-emp-kpi dd-rep-kpi") { Icon "lucide:circle-check"  Span "{cop(empresa.cobrado)}" class("v")    Span "Cobrado" class("l") }
            Stack class("dd-emp-kpi dd-rep-kpi") { Icon "lucide:clock"         Span "{cop(empresa.pendiente)}" class("v")  Span "Pendiente" class("l") }
          }
          # Pendientes de cobro (paseos realizados sin cobrar) — el jefe marca cobrado.
          Span "Pendientes de cobro · {cop(empresa.pendienteTotal)}" class("dd-emp-lbl")
          when empresa.nPendientes == 0 { Text "Todo al día — nada por cobrar." class("dd-cli-empty") }
          Stack class("dd-cat-list") {
            each empresa.pendientes as pe {
              Stack class("dd-cat-item") {
                Stack class("dd-sv-ic") { Icon "lucide:wallet" }
                Stack class("dd-cat-info") {
                  Stack class("nmline") { Span "{pe.perro}" class("nm")  Span "{pe.servicio}" class("cd") }
                  Span "{pe.fecha} · {cop(pe.monto)}" class("meta")
                }
                Stack class("acts") {
                  Button "Cobrado" -> cobrar(pe.id) class("dd-cat-add dd-cobrar-btn")
                }
              }
            }
          }

          Stack class("dd-rep-card") { Chart @empresa.ingresosDia "Ingresos por día (7d)" kind(bar) x(dia) y(monto) }
          Stack class("dd-rep-card") { Chart @empresa.topServicios "Top servicios (30d)" kind(donut) x(servicio) y(monto) }
          Span "Por paseador (30d)" class("dd-emp-lbl")
          Stack class("dd-cat-list") {
            each empresa.porPaseador as pp {
              Stack class("dd-cat-item") {
                Stack class("av") { Span "{initial(pp.nombre)}" }
                Stack class("dd-cat-info") {
                  Stack class("nmline") { Span "{pp.nombre}" class("nm") }
                  Span "{pp.paseos} paseos" class("meta")
                }
                Span "{cop(pp.monto)}" class("dd-rep-monto")
              }
            }
          }
        }
      }

      # ==== RESEÑAS (el jefe aprueba o rechaza antes de que sean públicas) ====
      when section == "resenas" and auth.isOwner {
        Stack class("dd-sec") {
          Stack class("dd-cat-head") { Title "Reseñas" h2 }
          Text "Solo se publican las aprobadas cuyo autor aceptó mostrar su nombre." class("dd-cli-hint")
          when empresa.nResenas == 0 {
            Stack class("dd-ph") { Stack class("dd-pi") { Icon "lucide:star" }  Title "Sin reseñas" h2  Text "Tus clientes pueden dejar una reseña después de un servicio finalizado." }
          }
          Stack class("dd-cat-list") {
            each empresa.resenas as r {
              Stack class("dd-cat-item") {
                Stack class("dd-sv-ic") { Icon "lucide:star" }
                Stack class("dd-cat-info") {
                  Stack class("nmline") { Span "{r.autor} · {r.rating} de 5" class("nm")  Span "{r.estado}" class("cd") }
                  Span "{r.texto}" class("dd-rs-txt")
                  when not r.publicar { Span "Sin permiso para publicar su nombre" class("obs") }
                }
                Stack class("acts") {
                  when r.estado != "aprobada" { Button "Aprobar" -> moderar(r.id, "aprobada") class("dd-cat-add") }
                  when r.estado != "rechazada" { Button "Rechazar" -> moderar(r.id, "rechazada") class("dd-cat-icon dd-danger") }
                }
              }
            }
          }
        }
      }

      # ==== PERROS (catálogo del negocio — ABM del jefe) ====
      when section == "perros" {
        Stack class("dd-sec") {
          Stack class("dd-cat-head") {
            Title "Perros" h2
            Button -> perroNuevo class("dd-cat-add") { Icon "lucide:plus"  Span "Agregar" }
          }
          when catalogo.total == 0 {
            Stack class("dd-ph") { Stack class("dd-pi") { Icon "lucide:dog" }  Title "Sin perros" h2  Text "Registrá los perros del negocio." }
          }
          Stack class("dd-cat-list") {
            each catalogo.perros as p {
              Stack class("dd-cat-item") {
                Stack class("av") {
                  when p.foto { Image "{p.foto}" alt("{p.nombre}") }
                  when p.foto == "" { Span "🐕" }
                }
                Stack class("dd-cat-info") {
                  Stack class("nmline") { Span "{p.nombre}" class("nm")  when p.raza { Span "{p.raza}" class("cd") }  when p.celo { Span "En celo" class("dd-soc dd-soc-cuidado") } }
                  when p.tamano { Span "{p.tamano}" class("meta") }
                  Span "{estadoCertificado(p.certificado)}" class("meta dd-cert")
                }
                Stack class("acts") {
                  Button -> perroEditar(p.id, p.nombre, p.raza, p.tamano, p.conducta, p.sociabilidad, p.tips, p.foto, p.celo, p.certificado) class("dd-cat-icon") aria(label: "Editar perro") { Icon "lucide:pencil" }
                  Button -> perroBorrar(p.id) class("dd-cat-icon dd-danger") aria(label: "Eliminar perro") { Icon "lucide:trash-2" }
                }
              }
            }
          }
          when pform {
            Stack class("dd-cal-scrim") {
              Stack class("dd-cal-scrimbg") on(click: perroCerrar)
              Stack class("dd-cal-sheet") aria(role: "dialog", modal: true) {
                Stack class("dd-cat-formhead") {
                  Title "Datos del perro" h3
                  Button -> perroCerrar class("dd-cal-sheet-x") aria(label: "Cerrar") { Icon "lucide:x" }
                }
                Form bind(pdraft) submit(perroGuardar) "Guardar perro"
                Text "Certificado: fecha de expedición del certificado de salud. Vale 6 meses." class("dd-rel-hint")
                when pedit {
                  when auth.isOwner {
                    Stack class("dd-cat-list") {
                      Title "Dueños" h4
                      each empresa.duenos as d where d.perroId == pedit {
                        Stack class("dd-cat-item") {
                          Stack class("dd-cat-info") { Stack class("nmline") { Span "{d.nombre}" class("nm")  Span "{d.rol}" class("cd") } }
                          when d.rol == "co" {
                            Stack class("acts") { Button -> coQuitar(d.id) class("dd-cat-icon dd-danger") aria(label: "Quitar co-dueño") { Icon "lucide:user-minus" } }
                          }
                        }
                      }
                      Title "Agregar co-dueño" h4
                      each empresa.clientes as c {
                        Stack class("dd-cat-item") {
                          Stack class("dd-cat-info") { Span "{c.nombre}" class("nm") }
                          Stack class("acts") { Button -> coAgregar(c.id) class("dd-cat-icon") aria(label: "Agregar co-dueño") { Icon "lucide:user-plus" } }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }

      # ==== SERVICIOS (catálogo del negocio — ABM del jefe) ====
      when section == "servicios" {
        Stack class("dd-sec") {
          Stack class("dd-cat-head") {
            Title "Servicios" h2
            Button -> servicioNuevo class("dd-cat-add") { Icon "lucide:plus"  Span "Agregar" }
          }
          when servicios.total == 0 {
            Stack class("dd-ph") { Stack class("dd-pi") { Icon "lucide:tag" }  Title "Sin servicios" h2  Text "Creá tu oferta: paseo, guardería, baño, corte de garras…" }
          }
          Stack class("dd-cat-list") {
            each servicios.servicios as s {
              Stack class("dd-cat-item") {
                Stack class("dd-sv-ic") { Icon "lucide:tag" }
                Stack class("dd-cat-info") {
                  Stack class("nmline") { Span "{s.nombre}" class("nm")  Span "{tipoLabel(s.tipo)}" class("cd") }
                  Span "{s.duracion} min" class("meta")
                }
                Stack class("dd-sv-price") {
                  Span "{cop(s.precio)}" class("amt")
                  when s.modelo == "mensual" { Span "/mes" class("per") }
                }
                Stack class("acts") {
                  Button -> servicioEditar(s.id, s.nombre, s.tipo, s.duracion, s.precio, s.modelo) class("dd-cat-icon") aria(label: "Editar servicio") { Icon "lucide:pencil" }
                  Button -> servicioBorrar(s.id) class("dd-cat-icon dd-danger") aria(label: "Eliminar servicio") { Icon "lucide:trash-2" }
                }
              }
            }
          }
          when sform {
            Stack class("dd-cal-scrim") {
              Stack class("dd-cal-scrimbg") on(click: servicioCerrar)
              Stack class("dd-cal-sheet") aria(role: "dialog", modal: true) {
                Stack class("dd-cat-formhead") {
                  Title "Datos del servicio" h3
                  Button -> servicioCerrar class("dd-cal-sheet-x") aria(label: "Cerrar") { Icon "lucide:x" }
                }
                Form bind(sdraft) submit(servicioGuardar) "Guardar servicio"
              }
            }
          }
        }
      }

      # ==== PERFIL ====
      when section == "perfil" {
        Stack class("dd-sec") {
          Stack class("dd-pf-hero") {
            Span "{initial(auth.userName)}" class("dd-pf-av")
            Span "{auth.userName}" class("dd-pf-name")
            when auth.isOwner { Span "Dueño" class("dd-pf-role") }
            when auth.isGestion { Span "Gestión" class("dd-pf-role") }
          }
          Stack class("dd-pf-stats") {
            Stack class("dd-pf-stat") { Span "{empresa.nPaseadores}" class("v")  Span "Paseadores" class("l") }
            when auth.isOwner { Stack class("dd-pf-stat") { Span "{empresa.nClientes}" class("v")  Span "Clientes" class("l") } }
            when auth.isOwner { Stack class("dd-pf-stat") { Span "{empresa.perrosTot}" class("v")  Span "Perros" class("l") } }
          }

          # ---- Equipo de gestión (la oficina) — solo el jefe invita y ve ----
          when auth.isOwner {
            Stack class("dd-pf-team") {
              Stack class("dd-cat-head") {
                Title "Equipo de gestión" h2
                Button -> invAbrir("empresa") class("dd-cat-add") { Icon "lucide:user-plus"  Span "Invitar" }
              }
              # Invitaciones de gestión pendientes.
              each empresa.invitaciones as iv where iv.rol == "empresa" {
                InviteItem(iv: iv, onDelete: invBorrar)
              }
              when empresa.nGestion == 0 {
                Text "Aún no hay empleados de gestión. Invitá a alguien para compartir la oficina." class("dd-rel-hint")
              }
              Stack class("dd-cat-list") {
                each empresa.gestion as g {
                  Stack class("dd-cat-item") {
                    Stack class("av") { Span "{initial(g.nombre)}" }
                    Stack class("dd-cat-info") {
                      Stack class("nmline") { Span "{g.nombre}" class("nm") }
                      when g.telefono { Span "{g.telefono}" class("meta") }
                    }
                    Checkbox checked(g.finanzas) -> finanzasToggle(g.id, not g.finanzas) "Finanzas"
                  }
                }
              }
            }
          }

          # ---- Datos legales del negocio (Ley 1480 art. 50 and 53) — only the owner writes them ----
          when auth.isOwner {
            Stack class("dd-pf-team") {
              Title "Datos legales del negocio" h2
              Text "Tus clientes los ven en su portal; la ley pide que el proveedor se identifique." class("dd-rel-hint")
              when not lhay { Text "Aún no registras los datos legales de tu negocio." class("dd-rel-hint") }
              Stack class("dd-gform") {
                Span "Nombre o razón social" class("dd-hor-lbl")
                SearchField bind(lrazon) "Nombre o razón social"
                Span "Tipo de documento" class("dd-hor-lbl")
                Stack class("dd-gsvc") {
                  Button "NIT" -> idTipo("NIT") class("dd-gchip") class("on" when ltipo == "NIT")
                  Button "Cédula de ciudadanía" -> idTipo("CC") class("dd-gchip") class("on" when ltipo == "CC")
                  Button "Cédula de extranjería" -> idTipo("CE") class("dd-gchip") class("on" when ltipo == "CE")
                  Button "Pasaporte" -> idTipo("PAS") class("dd-gchip") class("on" when ltipo == "PAS")
                }
                Span "Número de documento" class("dd-hor-lbl")
                SearchField bind(lnum) "Número de documento"
                Span "Dirección de notificaciones" class("dd-hor-lbl")
                SearchField bind(ldir) "Dirección de notificaciones"
                Span "Teléfono" class("dd-hor-lbl")
                SearchField bind(ltel) "Teléfono"
                Span "Correo" class("dd-hor-lbl")
                SearchField bind(lcorreo) "correo@ejemplo.com"
                Button "Guardar" -> idGuardar class("dd-cat-add dd-hor-save")
              }
            }
          }

          # ---- Políticas de tu negocio — only the owner publishes them; its clients accept each version ----
          when auth.isOwner {
            PoliticaEditor(version: polVer, fecha: polFecha, error: polError, onPublicar: polPublicar) {
              each pol as s {
                Stack class("dd-pol-sec") {
                  Span "{s.titulo}" class("dd-hor-lbl")
                  when s.req { Span "Obligatoria" class("dd-pol-req") }
                  Textarea bind(s.texto) "{s.titulo}" aria(label: s.titulo) class("dd-pol-txt")
                }
              }
            }
          }

          Stack class("dd-pf-list") { Link "" -> "/mis-datos" class("dd-pf-opt") { Icon "lucide:shield-check"  Span "Mis datos"  Icon "lucide:chevron-right" class("chev") } }
          Button -> salir class("dd-pf-logout") { Icon "lucide:log-out"  Span "Cerrar sesión" }
        }
      }

      # ---- Modal: editar salario ----
      when salForm {
        Stack class("dd-cal-scrim") {
          Stack class("dd-cal-scrimbg") on(click: salCerrar)
          Stack class("dd-cal-sheet") aria(role: "dialog", modal: true) {
            Stack class("dd-cat-formhead") {
              Title "Salario de {salNombre}" h3
              Button -> salCerrar class("dd-cal-sheet-x") aria(label: "Cerrar") { Icon "lucide:x" }
            }
            Stack class("dd-gform") {
              Span "Salario mensual (COP)" class("dd-hor-lbl")
              Number bind(salVal) min(0) max(100000000)
              Button "Guardar" -> salGuardar class("dd-cat-add dd-hor-save")
            }
          }
        }
      }

      # ---- Modal: invitar paseador / cliente ----
      when invForm {
        Stack class("dd-cal-scrim") {
          Stack class("dd-cal-scrimbg") on(click: invCerrar)
          Stack class("dd-cal-sheet") aria(role: "dialog", modal: true) {
            Stack class("dd-cat-formhead") {
              when invRol == "empresa" { Title "Invitar a gestión" h3 }
              when invRol == "paseador" { Title "Invitar paseador" h3 }
              when invRol == "cliente" { Title "Invitar cliente" h3 }
              Button -> invCerrar class("dd-cal-sheet-x") aria(label: "Cerrar") { Icon "lucide:x" }
            }
            Stack class("dd-gform") {
              Span "Correo del invitado" class("dd-hor-lbl")
              SearchField bind(invEmail) "correo@ejemplo.com"
              Text "El código queda atado a este correo, vence en 7 días y se muestra una sola vez." class("dd-rel-hint")
              Button "Crear invitación" -> invGuardar class("dd-cat-add dd-hor-save") disabled when not invValido
            }
          }
        }
      }

      # ---- Código recién creado: se ve una vez y se descarta ----
      when empresa.codigoNuevo.length > 0 {
        Stack class("dd-cal-scrim") {
          Stack class("dd-cal-sheet") aria(role: "dialog", modal: true) {
            InviteCode(code: empresa.codigoNuevo, email: empresa.codigoEmail, onCopyCode: copCod, onCopyLink: copLink, onClose: empresa.codigoCerrar)
          }
        }
      }

      # ---- Modal: asignar paseador a una salida ----
      when asigForm {
        Stack class("dd-cal-scrim") {
          Stack class("dd-cal-scrimbg") on(click: asigCerrar)
          Stack class("dd-cal-sheet") aria(role: "dialog", modal: true) {
            Stack class("dd-cat-formhead") {
              Title "Asignar a {asigNombre}" h3
              Button -> asigCerrar class("dd-cal-sheet-x") aria(label: "Cerrar") { Icon "lucide:x" }
            }
            Stack class("dd-gform") {
              Span "Elegí un paseador" class("dd-hor-lbl")
              Stack class("dd-gsvc") {
                Button "Sin asignar" -> asigElegir("", "") class("dd-gchip")
                each empresa.paseadores as p {
                  Button "{p.nombre}" -> asigElegir(p.id, p.nombre) class("dd-gchip")
                }
              }
            }
          }
        }
      }
    }
  }

  # ---------- BOTTOM NAV (móvil) ----------
  Nav class("dd-tabbar") {
    Button -> go("dashboard")  class("dd-on" when section == "dashboard")  aria(label: "Inicio") { Icon "lucide:home" }
    Button -> go("paseadores") class("dd-on" when section == "paseadores") aria(label: "Paseadores") { Icon "lucide:users" }
    Button -> go("clientes") class("dd-on" when section == "clientes")   aria(label: "Clientes") { Icon "lucide:user-round" }
    Button -> go("salidas")    class("dd-on" when section == "salidas")    aria(label: "Salidas") { Icon "lucide:map-pin" }
    Button -> go("agenda")     class("dd-on" when section == "agenda")     aria(label: "Agenda") { Icon "lucide:calendar" }
    when auth.isOwner {
      Button -> go("servicios") class("dd-on" when section == "servicios") aria(label: "Servicios") { Icon "lucide:tag" }
    }
    when auth.isOwner {
      Button -> go("resenas") class("dd-on" when section == "resenas") aria(label: "Reseñas") { Icon "lucide:star" }
    }
    when auth.verFinanzas {
      Button -> go("reportes") class("dd-on" when section == "reportes")   aria(label: "Reportes") { Icon "lucide:bar-chart-3" }
    }
    Button -> go("perfil")     class("dd-on" when section == "perfil")     aria(label: "Perfil") { Icon "lucide:user" }
  }
}
