# Service catalogue, backed by Supabase (table public.servicios). Rows load via SupaData;
# writes go through data.ts use-fns which persist + trigger a refresh.
use setServicioActivo from "~/lib/data.ts"

entity Servicio {
  nombre   text required
  desc     text
  emoji    text
  precio   number
  duracion number
  activo   bool
}

state {
  items = [] : list<Servicio>
}

get count     = items.length
get activos   = items.count where activo
get precioMin = items.min by precio

action setItems(rows: list<Servicio>) mutates items { items.set(rows) }

action toggle(sid: text, cur: bool) mutates items {
  items.patch where id == sid with { activo: not cur }
  setServicioActivo(sid, not cur)
}
