screen privacidad

use politicaVersion, irAlAncla from "~/lib/politica.js"

meta {
  title       "Política de tratamiento de datos | DevDogs"
  description "Borrador de la política de tratamiento de datos personales de DevDogs, pendiente de revisión legal."
  lang        "es"
}

# BORRADOR para revisión de un abogado. El texto vive en src/parts/politicatexto.muten.

get version = politicaVersion()
effect { irAlAncla() }

Page class("pv") {
  Stack class("pv-wrap") {
    Link "← Volver a DevDogs" -> "/" class("glink t-sm")

    PoliticaTexto(version: version)
  }
}
